<Item class="Folder" referent="RBX00000013"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Assets</string><ProtectedString name="Source"><![CDATA[-- Loads the converted Garry's Mod content (see tools/export-gmod.js).
-- Meshes are base64 blobs turned into EditableMeshes -> MeshParts at runtime.
-- Textures/sounds live in Studio's content folder and load via rbxasset://.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetService = game:GetService("AssetService")

local Config = require(script.Parent.Config)

local Assets = {}

local assetFolder = ReplicatedStorage:WaitForChild("GModAssets")
local Index = require(assetFolder:WaitForChild("Index"))
Assets.Index = Index

-- base64 --------------------------------------------------------------------------------
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local decodeMap = {}
for i = 1, #B64 do
	decodeMap[string.byte(B64, i)] = i - 1
end

local function decodeBase64(s)
	local n = #s
	local pad = 0
	if string.sub(s, -2) == "==" then
		pad = 2
	elseif string.sub(s, -1) == "=" then
		pad = 1
	end
	local outLen = math.floor(n / 4) * 3 - pad
	local out = buffer.create(outLen)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = bit32.lshift(decodeMap[a] or 0, 18) + bit32.lshift(decodeMap[b] or 0, 12)
			+ bit32.lshift(decodeMap[c] or 0, 6) + (decodeMap[d] or 0)
		if o < outLen then
			buffer.writeu8(out, o, bit32.rshift(v, 16))
		end
		if o + 1 < outLen then
			buffer.writeu8(out, o + 1, bit32.band(bit32.rshift(v, 8), 255))
		end
		if o + 2 < outLen then
			buffer.writeu8(out, o + 2, bit32.band(v, 255))
		end
		o = o + 3
		if i % 40000 == 1 then
			task.wait() -- keep big maps from freezing a frame
		end
	end
	return out
end

local function blobBuffer(id)
	local moduleName = Index.blobModule[tostring(id)]
	local module = moduleName and assetFolder.Blobs:FindFirstChild(moduleName)
	if not module then
		error("missing mesh blob " .. tostring(id))
	end
	return decodeBase64(require(module)[id])
end

Assets.blobBuffer = blobBuffer

-- EditableMesh -------------------------------------------------------------------------------
-- Every MeshPart gets its own EditableMesh: one EditableMesh can't back several parts, so
-- sharing it made every prop after the first fall back to a plain box.
local bufferCache = {} -- blob id -> decoded buffer (decoding base64 is the slow part)
local warned = {}
local failed = false

local function warnOnce(msg)
	if not warned[msg] then
		warned[msg] = true
		warn("[GMR] " .. msg)
	end
end

local function decoded(id)
	local buf = bufferCache[id]
	if not buf then
		buf = blobBuffer(id)
		bufferCache[id] = buf
	end
	return buf
end

local function buildEditableMesh(id)
	local buf = decoded(id)
	local nv = buffer.readu32(buf, 0)
	local nt = buffer.readu32(buf, 4)
	local posAt = 8
	local nrmAt = posAt + nv * 12
	local uvAt = nrmAt + nv * 3
	local idxAt = uvAt + nv * 8
	local wide = nv > 65535

	local em = AssetService:CreateEditableMesh()
	local vids, nids, uids = table.create(nv), table.create(nv), table.create(nv)
	for i = 0, nv - 1 do
		local p = posAt + i * 12
		vids[i + 1] = em:AddVertex(Vector3.new(buffer.readf32(buf, p), buffer.readf32(buf, p + 4), buffer.readf32(buf, p + 8)))
		local q = nrmAt + i * 3
		nids[i + 1] = em:AddNormal(Vector3.new(buffer.readi8(buf, q) / 127, buffer.readi8(buf, q + 1) / 127, buffer.readi8(buf, q + 2) / 127))
		local u = uvAt + i * 8
		local v = buffer.readf32(buf, u + 4)
		if Config.FlipV then
			v = 1 - v
		end
		uids[i + 1] = em:AddUV(Vector2.new(buffer.readf32(buf, u), v))
	end
	for t = 0, nt - 1 do
		local a, b, c
		if wide then
			local p = idxAt + t * 12
			a, b, c = buffer.readu32(buf, p), buffer.readu32(buf, p + 4), buffer.readu32(buf, p + 8)
		else
			local p = idxAt + t * 6
			a, b, c = buffer.readu16(buf, p), buffer.readu16(buf, p + 2), buffer.readu16(buf, p + 4)
		end
		if Config.FlipWinding then
			b, c = c, b
		end
		local f = em:AddTriangle(vids[a + 1], vids[b + 1], vids[c + 1])
		em:SetFaceNormals(f, { nids[a + 1], nids[b + 1], nids[c + 1] })
		em:SetFaceUVs(f, { uids[a + 1], uids[b + 1], uids[c + 1] })
	end
	return em
end

-- Returns a fresh MeshPart for a blob, or nil. `fidelity` is an Enum.CollisionFidelity.
function Assets.meshPart(id, fidelity)
	local ok, em = pcall(buildEditableMesh, id)
	if not ok or not em then
		failed = true
		warnOnce("Couldn't build mesh (" .. tostring(em) .. "). Check Game Settings > Security > 'Allow Mesh / Image APIs'.")
		return nil
	end
	local okPart, part = pcall(function()
		return AssetService:CreateMeshPartAsync(Content.fromObject(em), { CollisionFidelity = fidelity or Enum.CollisionFidelity.Box })
	end)
	if not okPart then
		failed = true
		warnOnce("CreateMeshPartAsync failed: " .. tostring(part))
		pcall(function()
			em:Destroy()
		end)
		return nil
	end
	part.Anchored = true
	part.Destroying:Connect(function()
		pcall(function()
			em:Destroy()
		end)
	end)
	return part
end

function Assets.model(key)
	return Index.models[key]
end

function Assets.isMeshSupported()
	return not failed
end

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end
Assets.v3 = v3

-- {x,y,z, rx,ry,rz, ux,uy,uz} -> CFrame
function Assets.cframe(t)
	local right = Vector3.new(t[4], t[5], t[6])
	local up = Vector3.new(t[7], t[8], t[9])
	return CFrame.fromMatrix(Vector3.new(t[1], t[2], t[3]), right, up, right:Cross(up))
end

return Assets
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Shared tuning values. Distances are in studs; 1 stud = 14 Source units.
local Config = {
	-- Studio <-> Studio link (see relay/relay.js)
	RelayHost = "127.0.0.1",
	RelayPort = 27015,
	SyncInterval = 0.2, -- seconds between relay syncs (keeps us under HttpService's 500 req/min)

	-- Which converted map to load: "gm_flatgrass" or "gm_construct"
	Map = "gm_flatgrass",

	-- Local content installed by tools/export-gmod.js
	SoundRoot = "rbxasset://sounds/",
	TextureRoot = "rbxasset://textures/",
	MeshRoot = "rbxasset://meshes/",

	-- Mesh conventions; flip these if converted meshes render inside-out / upside-down
	FlipWinding = false,
	FlipV = false,

	-- Garry's Mod movement, converted from Source units
	Gravity = 600 / 14,
	WalkSpeed = 200 / 14,
	RunSpeed = 400 / 14,
	JumpPower = 16,

	MaxPropsPerPlayer = 250,
	ReachDistance = 32768 / 14,

	PhysgunMinDistance = 2,
	PhysgunScrollStep = 1.5,
	PhysgunResponsiveness = 45,

	NoclipSpeed = 40,
	NoclipFastSpeed = 120,

	Weapons = { "Physgun", "Toolgun", "Hands" },

	ToolModes = {
		{ id = "remover", name = "Remover", desc = "Remove an object." },
		{ id = "weld", name = "Weld", desc = "Weld two objects together. Click the world second to weld to the world." },
		{ id = "nocollide", name = "No Collide", desc = "Make two objects not collide with each other." },
		{ id = "rope", name = "Rope", desc = "Create a rope between two points." },
		{ id = "balloon", name = "Balloons", desc = "Create a balloon tied to an object or the world." },
		{ id = "thruster", name = "Thruster", desc = "Attach a thruster to a prop. Press G to toggle your thrusters." },
		{ id = "color", name = "Colour", desc = "Change the colour of an object." },
		{ id = "material", name = "Material", desc = "Change the material of an object." },
		{ id = "paint", name = "Paint", desc = "Hold left click to paint onto a surface." },
	},

	Palette = {
		Color3.fromRGB(255, 255, 255), Color3.fromRGB(30, 30, 30), Color3.fromRGB(220, 50, 47),
		Color3.fromRGB(255, 140, 0), Color3.fromRGB(250, 215, 50), Color3.fromRGB(80, 200, 70),
		Color3.fromRGB(40, 170, 160), Color3.fromRGB(50, 120, 230), Color3.fromRGB(120, 70, 210),
		Color3.fromRGB(230, 90, 170), Color3.fromRGB(140, 90, 50), Color3.fromRGB(150, 150, 150),
	},
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- Remote creation/lookup. The server creates remotes on demand, clients wait for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("GMRNet")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "GMRNet"
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("GMRNet")
	end
	return folder
end

local function get(className, name)
	local f = getFolder()
	local remote = f:FindFirstChild(name)
	if remote then
		return remote
	end
	if RunService:IsServer() then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = f
		return remote
	end
	return f:WaitForChild(name)
end

function Net.event(name)
	return get("RemoteEvent", name)
end

function Net.func(name)
	return get("RemoteFunction", name)
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">PropCatalog</string><ProtectedString name="Source"><![CDATA[-- Spawnable props, built from the converted Garry's Mod models.
-- On the server a prop is an invisible physics collider; clients attach the real mesh
-- (see Visuals) to any part tagged "GMRMdl".
local CollectionService = game:GetService("CollectionService")

local Assets = require(script.Parent.Assets)
local Config = require(script.Parent.Config)

local Catalog = {}
Catalog.List = {}
Catalog.ByName = {}

local Index = Assets.Index

local SOUND_MATERIAL = {
	wood_box = Enum.Material.Wood,
	metal_barrel = Enum.Material.Metal,
	metal_box = Enum.Material.Metal,
	metal_canister = Enum.Material.Metal,
	metal_solid = Enum.Material.Metal,
	metal_computer = Enum.Material.Metal,
	metal_chainlink = Enum.Material.Metal,
	soda_can = Enum.Material.Metal,
	paintcan = Enum.Material.Metal,
	plastic_barrel = Enum.Material.Plastic,
	plastic_box = Enum.Material.Plastic,
	rubber_tire = Enum.Material.Fabric,
	concrete_block = Enum.Material.Concrete,
}

for _, p in ipairs(Index.props) do
	local entry = {
		name = p.name, category = p.category, model = p.model, collider = p.collider, impact = p.impact,
		icon = p.icon, gibs = p.gibs, health = p.health, explosive = p.explosive,
	}
	Catalog.ByName[p.name] = entry
	table.insert(Catalog.List, entry)
end
-- tool-made props
local SPECIAL = {
	Balloon = { collider = "ball", impact = "plastic_box" },
	Thruster = { collider = "box", impact = "metal_solid" },
}
for name, info in pairs(SPECIAL) do
	if Index.special[name] then
		Catalog.ByName[name] = { name = name, model = Index.special[name], collider = info.collider, impact = info.impact, hidden = true }
	end
end

-- Collider placement relative to the model's own origin
local function colliderFor(entry)
	local m = Index.models[entry.model]
	local center = Assets.v3(m.center)
	local size = Assets.v3(m.size)
	size = Vector3.new(math.max(size.X, 0.2), math.max(size.Y, 0.2), math.max(size.Z, 0.2))
	if entry.collider == "ball" then
		local d = math.max(size.X, size.Y, size.Z)
		return Enum.PartType.Ball, Vector3.new(d, d, d), CFrame.new(center)
	elseif entry.collider == "cylinder" then
		-- the cylinder axis is the dimension that differs most from the other two
		local x, y, z = size.X, size.Y, size.Z
		local axis
		local dxy, dxz, dyz = math.abs(x - y), math.abs(x - z), math.abs(y - z)
		if dyz <= dxy and dyz <= dxz then
			axis = "X"
		elseif dxz <= dxy then
			axis = "Y"
		else
			axis = "Z"
		end
		local length, d
		local rot = CFrame.new()
		if axis == "X" then
			length, d = x, math.max(y, z)
		elseif axis == "Y" then
			length, d = y, math.max(x, z)
			rot = CFrame.Angles(0, 0, math.pi / 2)
		else
			length, d = z, math.max(x, y)
			rot = CFrame.Angles(0, math.pi / 2, 0)
		end
		return Enum.PartType.Cylinder, Vector3.new(length, d, d), CFrame.new(center) * rot
	end
	return Enum.PartType.Block, size, CFrame.new(center)
end

-- Builds an invisible physics part that clients dress with the real mesh.
-- `rel` is the collider's CFrame in model space (the "ColliderRel" attribute).
function Catalog.collider(modelKey, kind, impact)
	local entry = { model = modelKey, collider = kind or "box", impact = impact }
	local shape, size, rel = colliderFor(entry)
	local p = Instance.new("Part")
	p.Name = "Collider"
	p.Shape = shape
	p.Size = size
	p.Transparency = 1
	p.Material = SOUND_MATERIAL[impact or ""] or Enum.Material.Plastic
	p.Color = Color3.new(1, 1, 1)
	p:SetAttribute("Mdl", modelKey)
	p:SetAttribute("ColliderRel", rel)
	p:SetAttribute("Impact", impact)
	CollectionService:AddTag(p, "GMRMdl")
	Catalog.dress(p, modelKey, rel)
	return p, rel
end

-- Real GMod model: one SpecialMesh part per material, loading the .mesh/.png files the
-- exporter put in Studio's content folder. A Weld with a fixed C0 keeps each mesh at the
-- model origin no matter how the collider is moved later.
function Catalog.dress(collider, modelKey, rel)
	local data = Index.models[modelKey]
	if not data then
		return
	end
	local reach = (data.reach or 2) * 2
	for i, info in ipairs(data.parts) do
		if info.mesh then
			local mp = Instance.new("Part")
			mp.Name = "Mesh" .. i
			mp.Size = Vector3.new(reach, reach, reach)
			mp.CanCollide = false
			mp.CanQuery = false
			mp.CanTouch = false
			mp.Massless = true
			mp.CastShadow = true
			mp.CFrame = collider.CFrame * rel:Inverse()
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			sm.MeshId = Config.MeshRoot .. info.mesh
			sm.TextureId = info.tex and (Config.TextureRoot .. info.tex) or ""
			if info.color then
				sm.VertexColor = Vector3.new(info.color[1] / 255, info.color[2] / 255, info.color[3] / 255)
			end
			sm.Parent = mp
			mp:SetAttribute("BaseTex", sm.TextureId)
			local w = Instance.new("Weld")
			w.Part0 = collider
			w.Part1 = mp
			w.C0 = rel:Inverse()
			w.Parent = mp
			mp.Parent = collider
		end
	end
end

-- Colour tool: tints the mesh texture like GMod's render colour
function Catalog.tint(part, color)
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("SpecialMesh") then
			d.VertexColor = Vector3.new(color.R, color.G, color.B)
		end
	end
end

-- Material tool: swaps the mesh texture (nil restores the model's own)
function Catalog.setMaterial(part, png)
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("SpecialMesh") and d.Parent then
			d.TextureId = png and (Config.TextureRoot .. png) or (d.Parent:GetAttribute("BaseTex") or "")
		end
	end
end

function Catalog.build(name)
	local entry = Catalog.ByName[name]
	local model = Instance.new("Model")
	model.Name = name
	if not entry or not Index.models[entry.model] then
		local p = Instance.new("Part")
		p.Name = "Collider"
		p.Size = Vector3.new(2, 2, 2)
		p.Color = Color3.fromRGB(255, 0, 220)
		p.Parent = model
		model.PrimaryPart = p
		return model
	end
	local p = Catalog.collider(entry.model, entry.collider, entry.impact)
	p.Parent = model
	model.PrimaryPart = p
	return model
end

return Catalog
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX0000001C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000019"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Breakables</string><ProtectedString name="Source"><![CDATA[-- Prop health, breaking into the model's real gibs, and explosive barrels.
-- Health/gibs/explosion values come from each GMod model's prop_data and .phy break list.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.PropCatalog)
local Net = require(Shared.Net)

local Breakables = {}

local Effect = Net.event("Effect")
local Sfx = Net.event("Sfx")

local GIB_LIFETIME = 15
local IMPACT_THRESHOLD = 22 -- studs/s of sudden velocity change before impacts hurt (~300 units/s)
local IMPACT_SCALE = 2.2

local BREAK_SOUND = {
	wood_box = "break_wood", metal_barrel = "break_metal", metal_box = "break_metal", plastic_barrel = "break_plastic",
	plastic_box = "break_flesh", metal_canister = "break_metal", metal_solid = "break_metal",
}

local lastVel = setmetatable({}, { __mode = "k" })

local function entryOf(model)
	return Catalog.ByName[model:GetAttribute("PropName") or ""]
end

local explode -- forward declaration

function Breakables.breakProp(model, impulse)
	if not model.Parent or model:GetAttribute("Broken") then
		return
	end
	model:SetAttribute("Broken", true)
	local entry = entryOf(model)
	local root = model.PrimaryPart
	if not entry or not root then
		model:Destroy()
		return
	end
	local rel = root:GetAttribute("ColliderRel") or CFrame.new()
	local origin = root.CFrame * rel:Inverse()
	local vel = root.AssemblyLinearVelocity + (impulse or Vector3.zero)
	local angVel = root.AssemblyAngularVelocity
	local pos = root.Position
	Effect:FireAllClients("break", pos, root.Size, entry.impact)
	Sfx:FireAllClients(BREAK_SOUND[entry.impact or ""] or "break_wood", pos)

	local folder = workspace:FindFirstChild("Debris") or Instance.new("Folder")
	folder.Name = "Debris"
	folder.Parent = workspace
	for _, gibKey in ipairs(entry.gibs or {}) do
		local gib, gibRel = Catalog.collider(gibKey, "box", entry.impact)
		gib.Name = "Gib"
		gib.CFrame = origin * gibRel
		gib.CustomPhysicalProperties = PhysicalProperties.new(0.5, 0.4, 0.2)
		gib:SetAttribute("FadeAt", os.time() + GIB_LIFETIME - 3)
		CollectionService:AddTag(gib, "GMRDebris")
		gib.Parent = folder
		local outward = (gib.Position - pos)
		outward = outward.Magnitude > 0.01 and outward.Unit or Vector3.yAxis
		gib.AssemblyLinearVelocity = vel + outward * math.random(4, 12) + Vector3.new(0, math.random(2, 6), 0)
		gib.AssemblyAngularVelocity = angVel + Vector3.new(math.random(-6, 6), math.random(-6, 6), math.random(-6, 6))
		Debris:AddItem(gib, GIB_LIFETIME)
	end
	local explosive = entry.explosive
	model:Destroy()
	if explosive then
		explode(pos, explosive.damage, explosive.radius)
	end
end

function Breakables.damage(model, amount, impulse)
	local entry = entryOf(model)
	if not entry or not entry.health or model:GetAttribute("Broken") then
		return
	end
	local hp = (model:GetAttribute("Health") or entry.health) - amount
	model:SetAttribute("Health", hp)
	if hp <= 0 then
		Breakables.breakProp(model, impulse)
	end
end

-- HL2-style explosion: hurts players, damages/breaks props, pushes everything.
explode = function(pos, damage, radius)
	Effect:FireAllClients("explosion", pos, radius)
	Sfx:FireAllClients("explode", pos)
	local blast = Instance.new("Explosion")
	blast.Position = pos
	blast.BlastRadius = radius
	blast.BlastPressure = 0
	blast.DestroyJointRadiusPercent = 0
	blast.ExplosionType = Enum.ExplosionType.NoCraters
	blast.Visible = false
	blast.Parent = workspace

	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hum and hrp then
			local d = (hrp.Position - pos).Magnitude
			if d < radius then
				hum:TakeDamage(damage * (1 - d / radius))
				hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + (hrp.Position - pos).Unit * 40 * (1 - d / radius) + Vector3.new(0, 15, 0)
			end
		end
	end
	task.defer(function()
		for _, model in ipairs(CollectionService:GetTagged("GMRProp")) do
			local root = model.PrimaryPart
			if root and model.Parent and not model:GetAttribute("Remote") then
				local offset = root.Position - pos
				local d = offset.Magnitude
				if d < radius then
					local falloff = 1 - d / radius
					local dir = d > 0.01 and offset.Unit or Vector3.yAxis
					if not root.Anchored then
						root:ApplyImpulse(dir * root.AssemblyMass * 60 * falloff)
					end
					Breakables.damage(model, damage * falloff, dir * 30 * falloff)
				end
			end
		end
		for _, gib in ipairs(CollectionService:GetTagged("GMRDebris")) do
			local offset = gib.Position - pos
			if offset.Magnitude < radius and not gib.Anchored then
				gib:ApplyImpulse(offset.Unit * gib.AssemblyMass * 50 * (1 - offset.Magnitude / radius))
			end
		end
	end)
end
Breakables.explode = explode

-- Impact damage: sudden velocity changes on breakable props (thrown, dropped, hit).
function Breakables.start()
	RunService.Heartbeat:Connect(function()
		for _, model in ipairs(CollectionService:GetTagged("GMRProp")) do
			local entry = entryOf(model)
			local root = model.PrimaryPart
			if entry and entry.health and root and not root.Anchored and not model:GetAttribute("Remote") then
				local v = root.AssemblyLinearVelocity
				local prev = lastVel[root]
				lastVel[root] = v
				if prev and not model:GetAttribute("HeldBy") then
					local dv = (v - prev).Magnitude
					-- explosive barrels: physgun_interactions "onfirstimpact" "break"
					local thrown = model:GetAttribute("ThrownAt")
					if entry.explosive and thrown and os.clock() - thrown < 4 and dv > 8 then
						model:SetAttribute("ThrownAt", nil)
						Breakables.breakProp(model)
					elseif dv > IMPACT_THRESHOLD then
						Breakables.damage(model, (dv - IMPACT_THRESHOLD) * IMPACT_SCALE)
					end
				end
			end
		end
	end)
end

return Breakables
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds a converted Garry's Mod map (gm_flatgrass / gm_construct) out of ordinary parts,
-- so it replicates and renders without any special APIs:
--   * box brushes   -> Parts with the real GMod textures on each face (Texture instances)
--   * other brushes and displacements -> triangles made of two WedgeParts each
--   * water         -> Terrain water, static props -> colliders dressed by clients
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Catalog = require(Shared.PropCatalog)

local MapBuilder = {}

local FACE_ORDER = {
	Enum.NormalId.Right, Enum.NormalId.Left, Enum.NormalId.Top,
	Enum.NormalId.Bottom, Enum.NormalId.Back, Enum.NormalId.Front,
}
local WEDGE_THICKNESS = 0.2

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function smooth(p)
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = true
	CollectionService:AddTag(p, "GMRMap")
end

local function texture(part, face, mat, su, sv, ou, ov)
	if not mat or not mat.png then
		return
	end
	local t = Instance.new("Texture")
	t.Face = face
	t.Texture = Config.TextureRoot .. mat.png
	t.StudsPerTileU = math.max(0.05, su)
	t.StudsPerTileV = math.max(0.05, sv)
	t.OffsetStudsU = ou or 0
	t.OffsetStudsV = ov or 0
	t.Parent = part
end

local FACE_AXIS = {
	[Enum.NormalId.Right] = Vector3.xAxis, [Enum.NormalId.Left] = -Vector3.xAxis,
	[Enum.NormalId.Top] = Vector3.yAxis, [Enum.NormalId.Bottom] = -Vector3.yAxis,
	[Enum.NormalId.Back] = Vector3.zAxis, [Enum.NormalId.Front] = -Vector3.zAxis,
}
local SKIN = 0.02

local function buildBox(b, mats, parent)
	local size = Vector3.new(b[10], b[11], b[12])
	local cf = Assets.cframe(b)
	local p = Instance.new("Part")
	p.Name = "Brush"
	p.Size = size
	p.CFrame = cf
	smooth(p)
	local faces = {}
	for i, face in ipairs(FACE_ORDER) do
		local f = b[12 + i]
		if type(f) == "table" and mats[f[1]] then
			table.insert(faces, { face = face, f = f, mat = mats[f[1]] })
		end
	end
	if #faces == 6 then
		-- every side is visible: one textured part does it
		p.Color = rgb(faces[1].mat.color)
		for _, info in ipairs(faces) do
			texture(p, info.face, info.mat, info.f[2], info.f[3], info.f[4], info.f[5])
		end
		p.Parent = parent
		return
	end
	-- some sides are nodraw/skybox/clip: invisible collider + a thin skin per visible side,
	-- so hidden faces never show up as solid black walls
	p.Transparency = 1
	p.Parent = parent
	for _, info in ipairs(faces) do
		local axis = FACE_AXIS[info.face]
		local thick = math.abs(axis.X) * size.X + math.abs(axis.Y) * size.Y + math.abs(axis.Z) * size.Z
		local skinSize = Vector3.new(
			axis.X ~= 0 and SKIN or size.X,
			axis.Y ~= 0 and SKIN or size.Y,
			axis.Z ~= 0 and SKIN or size.Z
		)
		local skin = Instance.new("Part")
		skin.Name = "BrushFace"
		skin.Size = skinSize
		skin.CFrame = cf * CFrame.new(axis * (thick / 2 - SKIN / 2))
		smooth(skin)
		skin.CanCollide = false
		skin.CanQuery = false
		skin.CanTouch = false
		skin.Color = rgb(info.mat.color)
		texture(skin, info.face, info.mat, info.f[2], info.f[3], info.f[4], info.f[5])
		skin.Parent = parent
	end
end

-- One triangle from two wedges (thickness pushed behind the surface).
local function triangle(a, b, c, parent, color, mat, scale)
	local surfaceNormal = (b - a):Cross(c - a) -- outward, before the vertices get reordered
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd < 1e-6 or acd < 1e-6 or bcd < 1e-6 then
		return
	end
	-- make bc the longest edge
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cr = ac:Cross(ab)
	if cr.Magnitude < 1e-6 then
		return
	end
	local right = cr.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 1e-3 then
		return
	end
	local inward = (right:Dot(surfaceNormal) > 0 and -right or right) * (WEDGE_THICKNESS / 2)
	local function wedge(size, cf)
		local w = Instance.new("WedgePart")
		w.Size = size
		w.CFrame = cf + inward
		smooth(w)
		w.Color = color
		if mat then
			texture(w, Enum.NormalId.Right, mat, scale[1], scale[2])
			texture(w, Enum.NormalId.Left, mat, scale[1], scale[2])
		else
			w.Transparency = 1
		end
		w.Parent = parent
	end
	wedge(Vector3.new(WEDGE_THICKNESS, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + b) / 2, right, up, back))
	wedge(Vector3.new(WEDGE_THICKNESS, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) / 2, -right, up, -back))
end

local function sky(map)
	local s = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	local faces = { bk = "SkyboxBk", dn = "SkyboxDn", ft = "SkyboxFt", lf = "SkyboxLf", rt = "SkyboxRt", up = "SkyboxUp" }
	for face, prop in pairs(faces) do
		if map.sky[face] then
			s[prop] = Config.TextureRoot .. map.sky[face]
		end
	end
	s.CelestialBodiesShown = false
	s.Parent = Lighting
end

-- Points Roblox's sun where the map's light_environment points, using its colours.
local function applyLighting(light)
	local function rgb255(t, k)
		if not t then
			return nil
		end
		k = k or 1
		return Color3.fromRGB(math.min(255, t[1] * k), math.min(255, t[2] * k), math.min(255, t[3] * k))
	end
	Lighting.GlobalShadows = true
	if light.sunDir then
		local want = Vector3.new(light.sunDir[1], light.sunDir[2], light.sunDir[3]).Unit
		local best, bestClock, bestLat = -2, 13, 0
		for lat = -80, 80, 4 do
			Lighting.GeographicLatitude = lat
			for clock = 6, 18, 0.25 do
				Lighting.ClockTime = clock
				local d = Lighting:GetSunDirection():Dot(want)
				if d > best then
					best, bestClock, bestLat = d, clock, lat
				end
			end
		end
		-- refine around the best match
		for lat = bestLat - 4, bestLat + 4, 0.5 do
			Lighting.GeographicLatitude = lat
			for clock = bestClock - 0.25, bestClock + 0.25, 0.02 do
				Lighting.ClockTime = clock
				local d = Lighting:GetSunDirection():Dot(want)
				if d > best then
					best, bestClock, bestLat = d, clock, lat
				end
			end
		end
		Lighting.GeographicLatitude = bestLat
		Lighting.ClockTime = bestClock
	end
	-- _light "r g b brightness": brightness ~250-600 in HL2 maps
	local sunBright = light.sun and light.sun[4] or 300
	Lighting.Brightness = math.clamp(sunBright / 110, 1.5, 4)
	Lighting.ColorShift_Top = rgb255(light.sun) or Color3.fromRGB(255, 245, 235)
	Lighting.ColorShift_Bottom = Color3.new(0, 0, 0)
	-- _ambient is the sky light: drive outdoor ambient with it, keep indoor darker
	local amb = light.ambient
	local ambK = amb and math.clamp((amb[4] or 150) / 300, 0.35, 0.8) or 0.55
	Lighting.OutdoorAmbient = rgb255(amb, ambK) or Color3.fromRGB(120, 130, 140)
	Lighting.Ambient = rgb255(amb, ambK * 0.55) or Color3.fromRGB(70, 75, 80)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.25

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if sky then
		sky.CelestialBodiesShown = light.showSun == true
		sky.SunAngularSize = 8
		sky.MoonTextureId = ""
		sky.StarCount = 0
	end

	local function ensure(class)
		local inst = Lighting:FindFirstChildOfClass(class)
		if not inst then
			inst = Instance.new(class)
			inst.Parent = Lighting
		end
		return inst
	end
	-- Source's distance fog (env_fog_controller) maps onto Atmosphere haze
	local atm = ensure("Atmosphere")
	atm.Density = light.fogColor and 0.18 or 0.1
	atm.Offset = 0
	atm.Haze = light.fogColor and 0.6 or 0.2
	atm.Glare = 0
	atm.Color = rgb255(light.fogColor) or Color3.fromRGB(200, 215, 230)
	atm.Decay = Color3.fromRGB(110, 125, 135)
	local cc = ensure("ColorCorrectionEffect")
	cc.Contrast = 0.06
	cc.Saturation = 0.05
	cc.Brightness = 0
	local bloom = ensure("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.6
	local rays = ensure("SunRaysEffect")
	rays.Intensity = 0.02
	rays.Spread = 0.6
end

function MapBuilder.clear()
	for _, n in ipairs({ "Map", "Debris" }) do
		local f = workspace:FindFirstChild(n)
		if f then
			f:Destroy()
		end
	end
	workspace.Terrain:Clear()
end

function MapBuilder.build(mapName)
	if workspace:FindFirstChild("Map") then
		return workspace.Map
	end
	-- folders other scripts wait on come first, so nothing below can block them
	for _, n in ipairs({ "Props", "RemoteProps", "RemotePlayers" }) do
		if not workspace:FindFirstChild(n) then
			local f = Instance.new("Folder")
			f.Name = n
			f.Parent = workspace
		end
	end
	local name = mapName or Config.Map
	workspace:SetAttribute("GMRMap", name)
	workspace.Gravity = Config.Gravity
	local folder = Instance.new("Folder")
	folder.Name = "Map"
	folder.Parent = workspace


	local module = ReplicatedStorage.GModAssets:FindFirstChild("Maps") and ReplicatedStorage.GModAssets.Maps:FindFirstChild(name)
	if not module then
		warn("[GMR] Map '" .. tostring(name) .. "' wasn't exported. Run setup.bat. Using a flat baseplate.")
		local p = Instance.new("Part")
		p.Size = Vector3.new(2000, 2, 2000)
		p.Position = Vector3.new(0, -1, 0)
		smooth(p)
		p.Parent = folder
		return folder
	end
	local map = require(module)
	sky(map)
	applyLighting(map.light or {})

	-- spawns first so players don't fall while the rest streams in
	for i, s in ipairs(map.spawns) do
		if i > 16 then
			break
		end
		local pad = Instance.new("SpawnLocation")
		pad.Anchored = true
		pad.Size = Vector3.new(4, 0.2, 4)
		pad.CFrame = CFrame.new(s[1], s[2] + 0.2, s[3])
		pad.Transparency = 1
		pad.CanCollide = false
		pad.CanQuery = false
		pad.Neutral = true
		pad.Duration = 0
		local decal = pad:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
		pad.Parent = folder
	end

	local mats = map.materials
	for i, b in ipairs(map.boxes) do
		buildBox(b, mats, folder)
		if i % 300 == 0 then
			task.wait()
		end
	end

	-- info_player_start can float above the floor; drop the pads onto whatever is below
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	for _, pad in ipairs(folder:GetChildren()) do
		if pad:IsA("SpawnLocation") then
			local hit = workspace:Raycast(pad.Position + Vector3.new(0, 3, 0), Vector3.new(0, -200, 0), params)
			if hit and hit.Instance ~= pad then
				pad.CFrame = CFrame.new(hit.Position + Vector3.new(0, 0.2, 0))
			end
		end
	end

	local triFolder = Instance.new("Folder")
	triFolder.Name = "Triangles"
	triFolder.Parent = folder
	local built = 0
	for _, group in ipairs(map.tris) do
		local mat = group.m > 0 and mats[group.m] or nil
		local color = mat and rgb(mat.color) or Color3.new(0.5, 0.5, 0.5)
		local v = group.v
		for i = 1, #v, 9 do
			triangle(
				Vector3.new(v[i], v[i + 1], v[i + 2]),
				Vector3.new(v[i + 3], v[i + 4], v[i + 5]),
				Vector3.new(v[i + 6], v[i + 7], v[i + 8]),
				triFolder, color, mat, group.scale
			)
			built = built + 1
			if built % 400 == 0 then
				task.wait()
			end
		end
	end

	for _, w in ipairs(map.water) do
		workspace.Terrain:FillBlock(CFrame.new(w[1], w[2], w[3]), Vector3.new(w[4], w[5], w[6]), Enum.Material.Water)
	end

	for _, sp in ipairs(map.staticProps) do
		if Assets.Index.models[sp.model] then
			local part, rel = Catalog.collider(sp.model, "box", nil)
			part.Name = "StaticProp"
			part.Anchored = true
			part.CanCollide = sp.solid
			part.CFrame = Assets.cframe(sp.cf) * rel
			CollectionService:AddTag(part, "GMRMap")
			part.Parent = folder
		end
	end
	print(string.format("[GMR] Loaded %s: %d brush parts, %d triangles, %d static props", name, #map.boxes, built, #map.staticProps))
	return folder
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[-- Prop ownership, spawning and per-player undo stacks.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.PropCatalog)
local Config = require(Shared.Config)

local Props = {}

local undoStacks = {} -- [userId] = { {label=, items={instances}} }
local nextId = 0

function Props.folder()
	return workspace:FindFirstChild("Props")
end

function Props.modelOf(inst)
	while inst and inst ~= workspace do
		if inst:IsA("Model") and CollectionService:HasTag(inst, "GMRProp") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

function Props.parts(model)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

function Props.countFor(player)
	local n = 0
	for _, m in ipairs(CollectionService:GetTagged("GMRProp")) do
		if m:GetAttribute("Owner") == player.UserId then
			n = n + 1
		end
	end
	return n
end

function Props.pushUndo(player, label, items)
	local stack = undoStacks[player.UserId]
	if not stack then
		stack = {}
		undoStacks[player.UserId] = stack
	end
	table.insert(stack, { label = label, items = items })
end

-- Pops entries until one still has something alive to remove.
function Props.undo(player)
	local stack = undoStacks[player.UserId]
	while stack and #stack > 0 do
		local entry = table.remove(stack)
		local removed = false
		for _, inst in ipairs(entry.items) do
			if inst.Parent then
				inst:Destroy()
				removed = true
			end
		end
		if removed then
			return entry.label
		end
	end
	return nil
end

function Props.cleanup(player)
	local n = 0
	for _, m in ipairs(CollectionService:GetTagged("GMRProp")) do
		if player == nil or m:GetAttribute("Owner") == player.UserId then
			m:Destroy()
			n = n + 1
		end
	end
	if player then
		undoStacks[player.UserId] = {}
	else
		undoStacks = {}
	end
	return n
end

function Props.forget(player)
	undoStacks[player.UserId] = nil
end

-- Creates a catalog prop as an owned, tagged model. Does not parent it.
function Props.create(player, name)
	local model = Catalog.build(name)
	nextId = nextId + 1
	model:SetAttribute("PropId", tostring(nextId))
	model:SetAttribute("PropName", name)
	model:SetAttribute("Owner", player and player.UserId or 0)
	CollectionService:AddTag(model, "GMRProp")
	if name == "Balloon" then
		model.Destroying:Connect(function()
			local root = model.PrimaryPart
			if root then
				local Net = require(Shared.Net)
				Net.event("Effect"):FireAllClients("balloonpop", root.Position, root.Color)
				Net.event("Sfx"):FireAllClients("balloon_pop", root.Position)
			end
		end)
	end
	return model
end

-- Spawns a menu prop resting on the surface the player is looking at.
function Props.spawn(player, name, hitPos, normal)
	if not Catalog.ByName[name] or Catalog.ByName[name].hidden then
		return nil, "Unknown prop"
	end
	if Props.countFor(player) >= Config.MaxPropsPerPlayer then
		return nil, "Prop limit reached"
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if typeof(hitPos) ~= "Vector3" or typeof(normal) ~= "Vector3" then
		return nil, "Bad spawn position"
	end
	if root and (root.Position - hitPos).Magnitude > Config.ReachDistance + 50 then
		hitPos = root.Position + root.CFrame.LookVector * 10
		normal = Vector3.yAxis
	end

	local model = Props.create(player, name)
	local collider = model.PrimaryPart
	local rel = collider:GetAttribute("ColliderRel") or CFrame.new()
	local up = normal.Unit
	local facing = root and Vector3.new(root.Position.X - hitPos.X, 0, root.Position.Z - hitPos.Z) or Vector3.zAxis
	if facing.Magnitude < 0.01 then
		facing = Vector3.zAxis
	end
	-- model stays upright and faces the player; push the collider out of the surface
	local rot = (CFrame.lookAt(Vector3.zero, facing.Unit) * rel).Rotation
	local s = collider.Size
	local half = math.abs(rot.RightVector:Dot(up)) * s.X / 2 + math.abs(rot.UpVector:Dot(up)) * s.Y / 2
		+ math.abs(rot.LookVector:Dot(up)) * s.Z / 2
	model:PivotTo(CFrame.new(hitPos + up * (half + 0.05)) * rot)
	model.Parent = Props.folder()
	Props.pushUndo(player, name, { model })
	return model
end

return Props
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Tools</string><ProtectedString name="Source"><![CDATA[-- Server side of the toolgun. Each mode validates the hit and builds constraints/props.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Assets = require(Shared.Assets)
local Catalog = require(Shared.PropCatalog)
local Props = require(script.Parent.Props)
local Net = require(Shared.Net)
local Effect = Net.event("Effect")

local Tools = {}

local pending = {} -- [userId] = { mode=, part=, pos= }  first click of two-click tools

local validModes = {}
for _, m in ipairs(Config.ToolModes) do
	validModes[m.id] = true
end

local function isWorld(part)
	return part == workspace.Terrain or CollectionService:HasTag(part, "GMRMap")
end

local function usable(part)
	return typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace)
end

local function attachmentAt(part, worldPos)
	local a = Instance.new("Attachment")
	a.Name = "GMRToolAttachment"
	if part == workspace.Terrain then
		a.WorldPosition = worldPos
	else
		a.Position = part.CFrame:PointToObjectSpace(worldPos)
	end
	a.Parent = part
	return a
end

local function sanitizeColor(c)
	if typeof(c) == "Color3" then
		return c
	end
	return Color3.new(1, 1, 1)
end

local handlers = {}

handlers.remover = function(player, part)
	local model = Props.modelOf(part)
	if not model then
		return false, "Can't remove that"
	end
	-- GMod's remover dissolves the object briefly before deleting it
	local root = model.PrimaryPart
	if root then
		Effect:FireAllClients("remove", root.CFrame, root.Size, model)
	end
	for _, p in ipairs(Props.parts(model)) do
		p.CanCollide = false
	end
	model:SetAttribute("Removing", true)
	task.delay(0.35, function()
		model:Destroy()
	end)
	return true, "Removed " .. (model:GetAttribute("PropName") or "prop"), "remove"
end

local function twoClick(player, mode, part, pos, onSecond)
	local first = pending[player.UserId]
	if not first or first.mode ~= mode or not first.part.Parent then
		if isWorld(part) and mode ~= "rope" then
			return false, "Pick a prop first"
		end
		pending[player.UserId] = { mode = mode, part = part, pos = pos }
		return true, "Now click the second object", "click", true
	end
	pending[player.UserId] = nil
	if first.part == part then
		return false, "Pick a different object"
	end
	return onSecond(first)
end

handlers.weld = function(player, part, pos)
	return twoClick(player, "weld", part, pos, function(first)
		if isWorld(part) then
			-- welding to the world freezes the prop in place
			first.part.Anchored = true
			return true, "Welded to world", "weld"
		end
		local w = Instance.new("WeldConstraint")
		w.Name = "GMRWeld"
		w.Part0 = first.part
		w.Part1 = part
		w.Parent = first.part
		Props.pushUndo(player, "Weld", { w })
		return true, "Welded", "weld"
	end)
end

handlers.nocollide = function(player, part, pos)
	return twoClick(player, "nocollide", part, pos, function(first)
		if isWorld(part) then
			return false, "Can't no-collide with the world"
		end
		local nc = Instance.new("NoCollisionConstraint")
		nc.Name = "GMRNoCollide"
		nc.Part0 = first.part
		nc.Part1 = part
		nc.Parent = first.part
		Props.pushUndo(player, "No-Collide", { nc })
		return true, "No-collided", "weld"
	end)
end

handlers.rope = function(player, part, pos, _, opts)
	return twoClick(player, "rope", part, pos, function(first)
		local a0 = attachmentAt(first.part, first.pos)
		local a1 = attachmentAt(part, pos)
		local rope = Instance.new("RopeConstraint")
		rope.Name = "GMRRope"
		rope.Attachment0 = a0
		rope.Attachment1 = a1
		rope.Length = (first.pos - pos).Magnitude + math.clamp(tonumber(opts.slack) or 2, 0, 50)
		rope.Visible = true
		rope.Thickness = 0.15
		rope.Color = BrickColor.new(sanitizeColor(opts.color))
		rope.Parent = a0
		Props.pushUndo(player, "Rope", { rope, a0, a1 })
		return true, "Rope created", "weld"
	end)
end

handlers.balloon = function(player, part, pos, normal, opts)
	local model = Props.create(player, "Balloon")
	local ball = model.PrimaryPart
	ball.Color = sanitizeColor(opts.color)
	ball:SetAttribute("Tinted", true)
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.05, 0.3, 0.5)
	local height = math.clamp(tonumber(opts.ropeLength) or 6, 1, 40)
	model:PivotTo(CFrame.new(pos + Vector3.new(0, height + ball.Size.Y / 2, 0)) * (ball:GetAttribute("ColliderRel") or CFrame.new()).Rotation)
	model.Parent = Props.folder()

	local liftAttach = Instance.new("Attachment")
	liftAttach.Parent = ball
	local lift = Instance.new("VectorForce")
	lift.Attachment0 = liftAttach
	lift.RelativeTo = Enum.ActuatorRelativeTo.World
	lift.ApplyAtCenterOfMass = true
	-- cancel the balloon's own weight, then pull with the chosen force
	lift.Force = Vector3.new(0, ball.AssemblyMass * workspace.Gravity + (tonumber(opts.force) or 500), 0)
	lift.Parent = ball

	local a0 = Instance.new("Attachment")
	a0.WorldPosition = ball.Position - Vector3.new(0, ball.Size.Y / 2, 0)
	a0.Parent = ball
	local a1 = attachmentAt(part, pos)
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = a0
	rope.Attachment1 = a1
	rope.Length = height
	rope.Visible = true
	rope.Thickness = 0.05
	rope.Color = BrickColor.new("White")
	rope.Parent = ball
	Props.pushUndo(player, "Balloon", { model, a1 })
	return true, "Balloon created", "spawn"
end

handlers.thruster = function(player, part, pos, normal, opts)
	if isWorld(part) then
		return false, "Thrusters go on props"
	end
	local model = Props.create(player, "Thruster")
	local body = model.PrimaryPart
	-- the thruster's up axis = surface normal; it pushes back into the surface
	local right = normal:Cross(Vector3.xAxis)
	if right.Magnitude < 0.1 then
		right = normal:Cross(Vector3.zAxis)
	end
	right = right.Unit
	local rel = body:GetAttribute("ColliderRel") or CFrame.new()
	local origin = CFrame.fromMatrix(pos, right, normal)
	body.CFrame = origin * rel
	body.Massless = true
	body.CanCollide = false
	model.Parent = Props.folder()
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = part
	weld.Parent = body

	local att = Instance.new("Attachment")
	att.Name = "ThrustAttachment"
	att.CFrame = rel:Inverse()
	att.Parent = body
	local vf = Instance.new("VectorForce")
	vf.Name = "Thrust"
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	vf.ApplyAtCenterOfMass = false
	vf.Force = Vector3.new(0, -math.clamp(tonumber(opts.force) or 1500, 50, 50000), 0)
	vf.Enabled = false
	vf.Parent = body
	model:SetAttribute("On", false)
	CollectionService:AddTag(model, "GMRThruster")
	Props.pushUndo(player, "Thruster", { model })
	return true, "Thruster attached (G to toggle)", "click"
end

handlers.color = function(player, part, pos, normal, opts)
	local model = Props.modelOf(part)
	if not model then
		return false, "Can't colour that"
	end
	local color = sanitizeColor(opts.color)
	for _, p in ipairs(Props.parts(model)) do
		p.Color = color
		p:SetAttribute("Tinted", color ~= Color3.new(1, 1, 1) or nil)
	end
	Catalog.tint(model, color)
	return true, "Coloured", "click"
end

handlers.material = function(player, part, pos, normal, opts)
	local model = Props.modelOf(part)
	if not model then
		return false, "Can't change that"
	end
	local choice = tostring(opts.material or "")
	local png
	for _, m in ipairs(Assets.Index.toolMaterials) do
		if m.name == choice then
			png = m.png
		end
	end
	if choice ~= "" and not png then
		return false, "Unknown material"
	end
	for _, p in ipairs(Props.parts(model)) do
		p:SetAttribute("MatOverride", png)
	end
	Catalog.setMaterial(model, png)
	return true, png and ("Material: " .. choice) or "Material reset", "click"
end

function Tools.fire(player, mode, part, pos, normal, opts)
	if not validModes[mode] or mode == "paint" then
		return false, "Bad mode"
	end
	if not usable(part) or typeof(pos) ~= "Vector3" or typeof(normal) ~= "Vector3" then
		return false, "Nothing there"
	end
	if part:GetAttribute("Remote") or (part.Parent and part.Parent:GetAttribute("Remote")) then
		return false, "That belongs to another Studio"
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - pos).Magnitude > Config.ReachDistance + 20 then
		return false, "Too far"
	end
	if typeof(opts) ~= "table" then
		opts = {}
	end
	return handlers[mode](player, part, pos, normal.Unit, opts)
end

function Tools.clearPending(player)
	pending[player.UserId] = nil
end

function Tools.toggleThrusters(player)
	local state
	for _, m in ipairs(CollectionService:GetTagged("GMRThruster")) do
		if m:GetAttribute("Owner") == player.UserId and m.PrimaryPart then
			if state == nil then
				state = not m:GetAttribute("On")
			end
			m:SetAttribute("On", state)
			local vf = m.PrimaryPart:FindFirstChild("Thrust")
			if vf then
				vf.Enabled = state
			end
		end
	end
	return state
end

return Tools
]]></ProtectedString></Properties></Item></Item>
<Item class="Script" referent="RBX0000001A"><Properties><string name="Name">SandboxServer</string><ProtectedString name="Source"><![CDATA[-- Sandbox gamemode server: wires remotes to the map, props, physgun and toolgun.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local Assets = require(Shared.Assets)
local Catalog = require(Shared.PropCatalog)

local Modules = script.Parent:WaitForChild("Modules")
local MapBuilder = require(Modules.MapBuilder)
local Props = require(Modules.Props)
local Tools = require(Modules.Tools)
local Breakables = require(Modules.Breakables)

local Effect = Net.event("Effect")

local okMap, mapErr = pcall(MapBuilder.build)
if not okMap then
	warn("[GMR] Map failed to load: " .. tostring(mapErr))
end
Breakables.start()

local Notify = Net.event("Notify")
local Sfx = Net.event("Sfx")
local SpawnProp = Net.event("SpawnProp")
local Undo = Net.event("Undo")
local Cleanup = Net.event("Cleanup")
local PhysGrab = Net.func("PhysGrab")
local PhysRelease = Net.event("PhysRelease")
local PhysUnfreeze = Net.event("PhysUnfreeze")
local ToolFire = Net.event("ToolFire")
local ToolReset = Net.event("ToolReset")
local ToolTracer = Net.event("ToolTracer")
local ThrusterToggle = Net.event("ThrusterToggle")
local Equip = Net.event("Equip")
local Flashlight = Net.event("Flashlight")
local Paint = Net.event("Paint")
local PaintHistory = Net.func("PaintHistory")
Net.event("RemoteChat")
Net.event("LinkStatus")
Net.event("LinkSetHost")

local function notify(player, text, kind)
	Notify:FireClient(player, text, kind or "generic")
end

local function sfxAll(name, pos)
	Sfx:FireAllClients(name, pos)
end

-- Spawning / undo --------------------------------------------------------------------
SpawnProp.OnServerEvent:Connect(function(player, name, hitPos, normal)
	local model, err = Props.spawn(player, tostring(name), hitPos, normal)
	if not model then
		notify(player, err, "error")
		return
	end
	sfxAll("spawn", model:GetPivot().Position)
	Effect:FireAllClients("propspawn", model)
end)

Undo.OnServerEvent:Connect(function(player)
	local label = Props.undo(player)
	if label then
		notify(player, "Undone " .. label, "undo")
	else
		notify(player, "Nothing to undo", "error")
	end
end)

Cleanup.OnServerEvent:Connect(function(player)
	local n = Props.cleanup(player)
	notify(player, "Cleaned up " .. n .. " props", "cleanup")
end)

-- Physgun --------------------------------------------------------------------------------
local holding = {} -- [player] = model

local function release(player, freeze)
	local model = holding[player]
	holding[player] = nil
	if not model or not model.Parent then
		return
	end
	local partName = model:GetAttribute("HeldPart")
	model:SetAttribute("HeldBy", nil)
	model:SetAttribute("HeldPart", nil)
	model:SetAttribute("HeldOffset", nil)
	CollectionService:RemoveTag(model, "GMRHeld")
	local part = partName and model:FindFirstChild(partName, true)
	if freeze and part then
		part.Anchored = true
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
		sfxAll("physgun_freeze", part.Position)
		Effect:FireAllClients("freeze", part)
		return
	end
	model:SetAttribute("ThrownAt", os.clock())
	-- leave ownership with the thrower briefly so the throw keeps its momentum
	task.delay(2, function()
		if model.Parent and not model:GetAttribute("HeldBy") then
			for _, p in ipairs(Props.parts(model)) do
				if not p.Anchored then
					pcall(function()
						p:SetNetworkOwnershipAuto()
					end)
				end
			end
		end
	end)
end

PhysGrab.OnServerInvoke = function(player, part, offset)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or typeof(offset) ~= "Vector3" then
		return false
	end
	local model = Props.modelOf(part)
	if not model or model:GetAttribute("Remote") then
		return false
	end
	local holder = model:GetAttribute("HeldBy")
	if holder and holder ~= player.UserId then
		return false
	end
	release(player, false)
	for _, p in ipairs(Props.parts(model)) do
		p.Anchored = false
	end
	if part.Anchored then
		-- welded to something frozen outside this prop
		return false
	end
	local ok = pcall(function()
		part:SetNetworkOwner(player)
	end)
	if not ok then
		return false
	end
	holding[player] = model
	model:SetAttribute("HeldBy", player.UserId)
	model:SetAttribute("HeldPart", part.Name)
	model:SetAttribute("HeldOffset", offset)
	CollectionService:AddTag(model, "GMRHeld")
	return true
end

PhysRelease.OnServerEvent:Connect(function(player, freeze)
	release(player, freeze == true)
end)

Net.event("PhysUnfreezeAll").OnServerEvent:Connect(function(player)
	local n = 0
	for _, model in ipairs(CollectionService:GetTagged("GMRProp")) do
		if model:GetAttribute("Owner") == player.UserId and not model:GetAttribute("Remote") then
			for _, p in ipairs(Props.parts(model)) do
				if p.Anchored and p.Name == "Collider" then
					p.Anchored = false
					n = n + 1
				end
			end
		end
	end
	if n > 0 then
		notify(player, "Unfroze " .. n .. " objects", "generic")
		sfxAll("physgun_on", (player.Character and player.Character:GetPivot().Position) or Vector3.zero)
	end
end)

PhysUnfreeze.OnServerEvent:Connect(function(player, part)
	if typeof(part) ~= "Instance" then
		return
	end
	local model = Props.modelOf(part)
	if not model or model:GetAttribute("Remote") then
		return
	end
	local n = 0
	for _, p in ipairs(Props.parts(model)) do
		if p.Anchored then
			p.Anchored = false
			n = n + 1
		end
	end
	if n > 0 then
		notify(player, "Unfroze " .. (model:GetAttribute("PropName") or "prop"), "generic")
		sfxAll("physgun_on", model:GetPivot().Position)
		Effect:FireAllClients("unfreeze", model.PrimaryPart)
	end
end)

-- Toolgun ------------------------------------------------------------------------------
ToolFire.OnServerEvent:Connect(function(player, mode, part, pos, normal, opts, muzzlePos)
	local ok, msg, sound, keepPending = Tools.fire(player, mode, part, pos, normal, opts)
	if typeof(muzzlePos) == "Vector3" and typeof(pos) == "Vector3" then
		ToolTracer:FireAllClients(player.UserId, muzzlePos, pos)
	end
	if ok then
		if sound then
			sfxAll(sound, pos)
		end
		notify(player, msg, keepPending and "hint" or "generic")
	else
		notify(player, msg or "Failed", "error")
	end
end)

ToolReset.OnServerEvent:Connect(function(player)
	Tools.clearPending(player)
end)

ThrusterToggle.OnServerEvent:Connect(function(player)
	local state = Tools.toggleThrusters(player)
	if state == nil then
		notify(player, "You have no thrusters", "error")
	else
		notify(player, state and "Thrusters ON" or "Thrusters OFF", "generic")
	end
end)

-- Paint: relay EditableImage strokes so every client draws the same thing ---------------
local paintLog = {}
local PAINT_LOG_MAX = 6000

Paint.OnServerEvent:Connect(function(player, part, face, a, b, color, radius)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return
	end
	if typeof(a) ~= "Vector2" or typeof(b) ~= "Vector2" or typeof(color) ~= "Color3" or typeof(face) ~= "EnumItem" then
		return
	end
	radius = math.clamp(tonumber(radius) or 4, 1, 32)
	local stroke = { part, face, a, b, color, radius }
	table.insert(paintLog, stroke)
	if #paintLog > PAINT_LOG_MAX then
		table.remove(paintLog, 1)
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			Paint:FireClient(other, part, face, a, b, color, radius)
		end
	end
end)

PaintHistory.OnServerInvoke = function()
	local live = {}
	for _, s in ipairs(paintLog) do
		if s[1].Parent then
			table.insert(live, s)
		end
	end
	return live
end

-- Weapons in third person / flashlight ---------------------------------------------------
local function handOf(char)
	return char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
end

Equip.OnServerEvent:Connect(function(player, weapon, modeName)
	local char = player.Character
	if not char then
		return
	end
	local old = char:FindFirstChild("GMRWeapon")
	if old then
		old:Destroy()
	end
	if typeof(weapon) ~= "string" then
		return
	end
	local hand = handOf(char)
	local key = Assets.Index.special[weapon]
	if not hand or not key then
		return
	end
	-- invisible anchor that every client dresses with the real world model
	local root, rel = Catalog.collider(key, "box")
	root.Name = "WeaponRoot"
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0, -root.Size.Z / 2)
	muzzle.Parent = root
	local model = Instance.new("Model")
	model.Name = "GMRWeapon"
	root.Parent = model
	model.PrimaryPart = root
	local grip = hand.Name == "RightHand" and CFrame.new(0, -0.2, -0.3) or CFrame.new(0, -1, -0.4)
	root.CFrame = hand.CFrame * grip * rel
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = root
	weld.Parent = root
	model.Parent = char
end)

Flashlight.OnServerEvent:Connect(function(player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local light = head:FindFirstChild("GMRFlashlight")
	if not light then
		light = Instance.new("SpotLight")
		light.Name = "GMRFlashlight"
		light.Face = Enum.NormalId.Front
		light.Range = 60
		light.Angle = 50
		light.Brightness = 3
		light.Enabled = false
		light.Parent = head
	end
	light.Enabled = not light.Enabled
	sfxAll("flashlight", head.Position)
end)

-- Main menu: map change / disconnect ----------------------------------------------------------
local ChangeMap = Net.event("ChangeMap")
local Disconnect = Net.event("Disconnect")
local changing = false

ChangeMap.OnServerEvent:Connect(function(player, name)
	if changing or typeof(name) ~= "string" then
		return
	end
	local valid = false
	for _, m in ipairs(Assets.Index.maps) do
		if m == name then
			valid = true
		end
	end
	if not valid then
		return
	end
	changing = true
	for _, plr in ipairs(Players:GetPlayers()) do
		Notify:FireClient(plr, player.DisplayName .. " is loading " .. name, "generic")
	end
	Props.cleanup(nil)
	MapBuilder.clear()
	local ok, err = pcall(MapBuilder.build, name)
	if not ok then
		warn("[GMR] Map change failed: " .. tostring(err))
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		plr:LoadCharacter()
	end
	changing = false
end)

Disconnect.OnServerEvent:Connect(function(player)
	player:Kick("Disconnected.")
end)

-- Players ----------------------------------------------------------------------------------
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		holding[player] = nil
		local hum = char:WaitForChild("Humanoid")
		hum.Died:Connect(function()
			player:SetAttribute("Deaths", (player:GetAttribute("Deaths") or 0) + 1)
		end)
		hum.WalkSpeed = Config.WalkSpeed
		hum.UseJumpPower = true
		hum.JumpPower = Config.JumpPower
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	release(player, false)
	Props.cleanup(player)
	Props.forget(player)
	Tools.clearPending(player)
end)

print(string.format("[GMR] Sandbox ready. Reach %d studs, %d props per player.", Config.ReachDistance, Config.MaxPropsPerPlayer))
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item>
<Item class="Script" referent="RBX0000001B"><Properties><string name="Name">StudioLink</string><ProtectedString name="Source"><![CDATA[-- Studio Link: syncs this play session with other Studio instances through a local relay
-- (relay/relay.js). Local players show up elsewhere as ghost avatars, local props as
-- anchored mirrors, and chat is forwarded.
--
-- Transport: tries HttpService directly first. If Studio blocks localhost for game
-- scripts, the GMR Link plugin (installed by build.js) answers through
-- ServerStorage.GMRLink.Transport, since plugins are allowed to reach localhost.
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Catalog = require(Shared.PropCatalog)

local LinkStatus = Net.event("LinkStatus")
local RemoteChat = Net.event("RemoteChat")
local LinkSetHost = Net.event("LinkSetHost")
local Sfx = Net.event("Sfx")

local instanceId = string.sub(HttpService:GenerateGUID(false), 1, 8)
local studioName = script:GetAttribute("StudioName") or ("Studio-" .. string.sub(instanceId, 1, 4))
local host = script:GetAttribute("RelayHost") or Config.RelayHost

-- Plugin bridge objects
local bridge = Instance.new("Folder")
bridge.Name = "GMRLink"
bridge.Parent = ServerStorage
local transportFn = Instance.new("BindableFunction")
transportFn.Name = "Transport"
transportFn.Parent = bridge

local state = {
	connected = false,
	transport = nil,
	err = nil,
	epoch = nil,
	cursor = 0,
	peers = {}, -- [instanceId] = name
}

local lastSent = {} -- [propId] = encoded part list
local chatQueue = {}

-- Serialization --------------------------------------------------------------------------------
local function r(n)
	return math.floor(n * 1000 + 0.5) / 1000
end

local function encodeCF(cf)
	local p, x, y = cf.Position, cf.RightVector, cf.UpVector
	return { r(p.X), r(p.Y), r(p.Z), r(x.X), r(x.Y), r(x.Z), r(y.X), r(y.Y), r(y.Z) }
end

local function decodeCF(t)
	if typeof(t) ~= "table" or #t < 9 then
		return CFrame.new()
	end
	return CFrame.fromMatrix(Vector3.new(t[1], t[2], t[3]), Vector3.new(t[4], t[5], t[6]), Vector3.new(t[7], t[8], t[9]))
end

local function encodeProp(model)
	local parts = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(parts, {
				n = p.Name,
				cf = encodeCF(p.CFrame),
				c = p.Color:ToHex(),
				m = p.Material.Name,
				t = p:GetAttribute("MatOverride"),
				tn = p:GetAttribute("Tinted"),
			})
		end
	end
	return { name = model:GetAttribute("PropName") or model.Name, parts = parts }
end

-- Ghost avatars ------------------------------------------------------------------------------------
local ghostFolder = workspace:WaitForChild("RemotePlayers")
local propFolder = workspace:WaitForChild("RemoteProps")
local ghosts = {} -- [key] = { model=, target=CFrame }
local mirrors = {} -- [key] = { model=, parts = {[name]={part=, target=}} }

local function peerColor(inst)
	local h = 0
	for i = 1, #inst do
		h = (h * 31 + string.byte(inst, i)) % 360
	end
	return Color3.fromHSV(h / 360, 0.6, 0.9)
end

local GHOST_LAYOUT = {
	{ "Torso", Vector3.new(2, 2, 1), CFrame.new(0, 0, 0) },
	{ "Head", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 1.6, 0) },
	{ "LeftArm", Vector3.new(1, 2, 1), CFrame.new(-1.5, 0, 0) },
	{ "RightArm", Vector3.new(1, 2, 1), CFrame.new(1.5, 0, 0) },
	{ "LeftLeg", Vector3.new(1, 2, 1), CFrame.new(-0.5, -2, 0) },
	{ "RightLeg", Vector3.new(1, 2, 1), CFrame.new(0.5, -2, 0) },
}

local function makeGhost(inst, name)
	local model = Instance.new("Model")
	model.Name = name
	local color = peerColor(inst)
	local root
	for _, def in ipairs(GHOST_LAYOUT) do
		local p = Instance.new("Part")
		p.Name = def[1]
		p.Size = def[2]
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Color = def[1] == "Head" and Color3.fromRGB(235, 205, 170) or color
		p.Material = Enum.Material.SmoothPlastic
		p:SetAttribute("Offset", def[3])
		p.Parent = model
		root = root or p
	end
	model.PrimaryPart = root
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(220, 40)
	tag.StudsOffset = Vector3.new(0, 3.4, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 300
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextSize = 16
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.3
	l.Text = name
	l.Parent = tag
	tag.Parent = root
	model.Parent = ghostFolder
	return model
end

local function placeGhost(model, cf)
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			p.CFrame = cf * p:GetAttribute("Offset")
		end
	end
end

-- Prop mirrors -------------------------------------------------------------------------------------
local function makeMirror(key, data)
	local model = Catalog.build(tostring(data.name))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Constraint") or d:IsA("WeldConstraint") or d:IsA("NoCollisionConstraint") then
			d:Destroy()
		end
	end
	model:SetAttribute("Remote", true)
	model:SetAttribute("RemoteKey", key)
	local parts = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p:SetAttribute("Remote", true)
			parts[p.Name] = { part = p }
		end
	end
	CollectionService:AddTag(model, "GMRRemoteProp")
	model.Parent = propFolder
	return { model = model, parts = parts, fresh = true }
end

local function applyMirror(key, data)
	if typeof(data) ~= "table" or typeof(data.parts) ~= "table" then
		return
	end
	local m = mirrors[key]
	if not m or not m.model.Parent then
		m = makeMirror(key, data)
		mirrors[key] = m
	end
	for _, pd in ipairs(data.parts) do
		local entry = m.parts[pd.n]
		if entry then
			local p = entry.part
			entry.target = decodeCF(pd.cf)
			if m.fresh then
				p.CFrame = entry.target
			end
			local okC, col = pcall(Color3.fromHex, pd.c or "ffffff")
			if okC then
				p.Color = col
			end
			local okM, mat = pcall(function()
				return Enum.Material[pd.m]
			end)
			if okM and mat then
				p.Material = mat
			end
			if p:GetAttribute("MatOverride") ~= pd.t then
				p:SetAttribute("MatOverride", pd.t)
			end
			if p:GetAttribute("Tinted") ~= pd.tn then
				p:SetAttribute("Tinted", pd.tn)
			end
		end
	end
	m.fresh = false
	-- mirror the other Studio's Colour/Material tool changes on the meshes
	for _, pd in ipairs(data.parts) do
		if pd.n == "Collider" then
			if pd.tn then
				local okC, col = pcall(Color3.fromHex, pd.c or "ffffff")
				if okC then
					Catalog.tint(m.model, col)
				end
			end
			Catalog.setMaterial(m.model, pd.t)
		end
	end
end

local function removeMirror(key)
	local m = mirrors[key]
	if m then
		m.model:Destroy()
		mirrors[key] = nil
	end
end

RunService.Heartbeat:Connect(function(dt)
	local alpha = math.min(1, dt * 12)
	for _, g in pairs(ghosts) do
		if g.target then
			g.current = g.current and g.current:Lerp(g.target, alpha) or g.target
			placeGhost(g.model, g.current)
		end
	end
	for _, m in pairs(mirrors) do
		for _, entry in pairs(m.parts) do
			if entry.target then
				entry.part.CFrame = entry.part.CFrame:Lerp(entry.target, alpha)
			end
		end
	end
end)

-- Payload build / apply ---------------------------------------------------------------------------------
local function buildPayload()
	local players = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if root then
			players[tostring(plr.UserId)] = { n = plr.DisplayName, cf = encodeCF(root.CFrame) }
		end
	end

	local props = {}
	local seen = {}
	for _, model in ipairs(CollectionService:GetTagged("GMRProp")) do
		local id = model:GetAttribute("PropId")
		if id and model.Parent and not model:GetAttribute("Remote") then
			seen[id] = true
			local data = encodeProp(model)
			local encoded = HttpService:JSONEncode(data)
			if lastSent[id] ~= encoded then
				props[id] = data
				lastSent[id] = encoded
			end
		end
	end
	local removed = {}
	for id in pairs(lastSent) do
		if not seen[id] then
			table.insert(removed, id)
			lastSent[id] = nil
		end
	end

	local chat = chatQueue
	chatQueue = {}
	return {
		instance = instanceId,
		name = studioName,
		epoch = state.epoch,
		cursor = state.cursor,
		players = players,
		props = props,
		removed = removed,
		chat = chat,
	}
end

local function broadcastStatus(eventText)
	local peers = {}
	for _, name in pairs(state.peers) do
		table.insert(peers, name)
	end
	table.sort(peers)
	LinkStatus:FireAllClients({
		enabled = true,
		connected = state.connected,
		host = host .. ":" .. Config.RelayPort,
		name = studioName,
		transport = state.transport,
		err = state.err,
		peers = peers,
		event = eventText,
	})
end

local function applyResponse(res)
	if res.epoch ~= state.epoch then
		-- relay restarted (or first contact): resend everything next tick
		state.epoch = res.epoch
		lastSent = {}
	end
	state.cursor = res.cursor or state.cursor

	-- peers
	local now = {}
	for _, peer in ipairs(res.peers or {}) do
		now[peer.id] = peer.name
	end
	for id, name in pairs(now) do
		if not state.peers[id] then
			broadcastStatus(name .. " joined the link")
			Sfx:FireAllClients("link_join")
		end
	end
	for id, name in pairs(state.peers) do
		if not now[id] then
			state.peers[id] = nil
			broadcastStatus(name .. " left the link")
			for key in pairs(mirrors) do
				if string.sub(key, 1, #id + 1) == id .. "/" then
					removeMirror(key)
				end
			end
		end
	end
	state.peers = now

	-- avatars: full list every time
	local alive = {}
	for _, pl in ipairs(res.players or {}) do
		local key = tostring(pl.inst) .. "/" .. tostring(pl.uid)
		alive[key] = true
		local g = ghosts[key]
		if not g then
			local label = string.format("%s  [%s]", tostring(pl.n), tostring(now[pl.inst] or "?"))
			g = { model = makeGhost(tostring(pl.inst), label) }
			ghosts[key] = g
		end
		g.target = decodeCF(pl.cf)
	end
	for key, g in pairs(ghosts) do
		if not alive[key] then
			g.model:Destroy()
			ghosts[key] = nil
		end
	end

	for _, pr in ipairs(res.props or {}) do
		applyMirror(tostring(pr.inst) .. "/" .. tostring(pr.id), pr.data)
	end
	for _, rm in ipairs(res.removed or {}) do
		removeMirror(tostring(rm.inst) .. "/" .. tostring(rm.id))
	end
	for _, msg in ipairs(res.chat or {}) do
		RemoteChat:FireAllClients(tostring(msg.from), tostring(msg.text))
	end
end

-- Transport ---------------------------------------------------------------------------------------------
local function url()
	return "http://" .. host .. ":" .. Config.RelayPort .. "/sync"
end

local function viaHttp(body)
	local res = HttpService:RequestAsync({
		Url = url(),
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = body,
	})
	if not res.Success then
		error("HTTP " .. tostring(res.StatusCode))
	end
	return res.Body
end

local function viaPlugin(body)
	if not bridge:GetAttribute("PluginReady") then
		error("GMR Link plugin not loaded")
	end
	local result
	local done = false
	task.spawn(function()
		local ok, out = pcall(function()
			return transportFn:Invoke(url(), body)
		end)
		result = ok and out or nil
		done = true
	end)
	local t = os.clock()
	while not done and os.clock() - t < 5 do
		task.wait()
	end
	if typeof(result) ~= "string" then
		error("plugin transport failed")
	end
	return result
end

local httpBroken = false

local function send(body)
	if not httpBroken then
		local ok, out = pcall(viaHttp, body)
		if ok then
			state.transport = "HttpService"
			return out
		end
		local msg = tostring(out)
		-- Distinguish "Studio won't let game scripts do this" from "relay isn't running"
		if string.find(msg, "not enabled") or string.find(msg, "denied") or string.find(msg, "not allowed")
			or string.find(msg, "Trust") or string.find(msg, "blocked") then
			httpBroken = true
			warn("[GMR Link] HttpService can't reach the relay (" .. msg .. "); switching to the plugin transport.")
		elseif not bridge:GetAttribute("PluginReady") then
			error(msg)
		end
	end
	local out = viaPlugin(body)
	state.transport = "plugin"
	return out
end

-- Hooks ------------------------------------------------------------------------------------------------------
local function hookChat(plr)
	plr.Chatted:Connect(function(msg)
		table.insert(chatQueue, { from = plr.DisplayName .. "@" .. studioName, text = string.sub(msg, 1, 200) })
	end)
end
Players.PlayerAdded:Connect(function(plr)
	hookChat(plr)
	task.wait(2)
	broadcastStatus()
end)
for _, plr in ipairs(Players:GetPlayers()) do
	hookChat(plr)
end

LinkSetHost.OnServerEvent:Connect(function(_, newHost)
	if typeof(newHost) ~= "string" or not string.match(newHost, "^[%w%.%-]+$") then
		return
	end
	host = newHost
	state.connected = false
	state.epoch = nil
	broadcastStatus("Relay set to " .. host)
end)

-- Main loop ------------------------------------------------------------------------------------------------------
task.spawn(function()
	print(string.format("[GMR Link] %s (%s) syncing to %s", studioName, instanceId, url()))
	local failures = 0
	while true do
		local payload = buildPayload()
		local ok, out = pcall(send, HttpService:JSONEncode(payload))
		local res
		if ok then
			local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, out)
			if okDecode then
				res = decoded
			else
				ok = false
				out = "bad JSON from relay"
			end
		end
		if ok and res then
			if not state.connected then
				state.connected = true
				state.err = nil
				failures = 0
				broadcastStatus("Studio Link connected (" .. state.transport .. ")")
			end
			applyResponse(res)
			task.wait(Config.SyncInterval)
		else
			-- unsent changes must be resent once the relay comes back
			lastSent = {}
			failures = failures + 1
			local wasConnected = state.connected
			state.connected = false
			state.err = tostring(out)
			if wasConnected or failures == 1 then
				broadcastStatus(wasConnected and "Studio Link lost" or nil)
			end
			task.wait(math.min(5, 1 + failures * 0.5))
		end
	end
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item>
<Item class="ServerStorage" referent="RBX0000001D"><Properties><string name="Name">ServerStorage</string></Properties></Item>
<Item class="StarterPlayer" referent="RBX0000002E"><Properties><string name="Name">StarterPlayer</string><token name="CameraMode">1</token></Properties><Item class="StarterPlayerScripts" referent="RBX0000002C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000002A"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Derma</string><ProtectedString name="Source"><![CDATA[-- Derma look-alike: draws GUI pieces from GMod's own skin atlas (gwenskin/gmoddefault.png)
-- using the same rectangles and borders as garrysmod/lua/skins/default.lua.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Assets = require(Shared.Assets)

local Derma = {}

local UI = Assets.Index.ui or {}
local SKIN = UI.skin and (Config.TextureRoot .. UI.skin) or nil

-- { x, y, w, h, left, top, right, bottom }
Derma.TEX = {
	Panel = { 256, 0, 63, 63, 16, 16, 16, 16 },
	PanelBright = { 320, 0, 63, 63, 16, 16, 16, 16 },
	PanelDark = { 256, 64, 63, 63, 16, 16, 16, 16 },
	Button = { 480, 0, 31, 31, 8, 8, 8, 8 },
	ButtonHover = { 480, 32, 31, 31, 8, 8, 8, 8 },
	ButtonDown = { 480, 96, 31, 31, 8, 8, 8, 8 },
	Tree = { 256, 128, 127, 127, 16, 16, 16, 16 },
	TabControl = { 0, 256, 127, 127, 8, 8, 8, 8 },
	TabActive = { 0, 384, 63, 31, 8, 8, 8, 8 },
	TabInactive = { 128, 384, 63, 31, 8, 8, 8, 8 },
	CategoryOuter = { 256, 384, 63, 63, 8, 8, 8, 8 },
	CategoryHeader = { 320, 352, 63, 31, 8, 8, 8, 8 },
	CategoryInner = { 320, 405, 63, 42, 8, 0, 8, 8 },
	TextBox = { 0, 150, 127, 21, 4, 4, 4, 4 },
	Selection = { 384, 32, 31, 31, 4, 4, 4, 4 },
	ListEven = { 352, 256, 31, 31, 8, 8, 8, 8 },
	ListOdd = { 352, 288, 31, 31, 8, 8, 8, 8 },
	ListSelected = { 320, 256, 31, 31, 8, 8, 8, 8 },
	ListHover = { 320, 320, 31, 31, 8, 8, 8, 8 },
	Tooltip = { 384, 64, 31, 31, 8, 8, 8, 8 },
	ScrollTrack = { 384, 208, 15, 127, 4, 4, 4, 4 },
	ScrollGrip = { 400, 208, 15, 127, 4, 4, 4, 4 },
}

local function rgb(t, fallback)
	if t then
		return Color3.fromRGB(t[1], t[2], t[3])
	end
	return fallback
end

local C = UI.colors or {}
Derma.Colors = {
	ButtonText = rgb(C.buttonNormal, Color3.fromRGB(82, 82, 82)),
	ButtonHover = rgb(C.buttonHover, Color3.fromRGB(46, 114, 178)),
	TabActive = rgb(C.tabActive, Color3.fromRGB(50, 50, 50)),
	TabInactive = rgb(C.tabInactive, Color3.fromRGB(120, 120, 120)),
	LabelDefault = rgb(C.labelDefault, Color3.fromRGB(80, 80, 80)),
	LabelBright = rgb(C.labelBright, Color3.new(1, 1, 1)),
	LabelDark = rgb(C.labelDark, Color3.fromRGB(30, 30, 30)),
	TreeNormal = rgb(C.treeNormal, Color3.fromRGB(70, 70, 70)),
	TreeSelected = rgb(C.treeSelected, Color3.fromRGB(46, 114, 178)),
	CategoryHeader = rgb(C.categoryHeader, Color3.new(1, 1, 1)),
	LineText = rgb(C.lineText, Color3.fromRGB(60, 60, 60)),
	LineTextSelected = rgb(C.lineTextSelected, Color3.new(1, 1, 1)),
	LineButton = rgb(C.lineButton, Color3.fromRGB(240, 240, 240)),
	LineButtonHover = rgb(C.lineButtonHover, Color3.fromRGB(200, 220, 240)),
	LineButtonSelected = rgb(C.lineButtonSelected, Color3.fromRGB(46, 114, 178)),
	LineAltButton = rgb(C.lineAltButton, Color3.fromRGB(230, 230, 230)),
}

-- Fonts installed by the exporter (Tahoma = DermaDefault, Verdana/HalfLife2 = HL2 HUD)
function Derma.font(family, weight)
	local uri = UI.fonts and UI.fonts[family]
	if uri then
		local ok, f = pcall(Font.new, uri, weight or Enum.FontWeight.Regular)
		if ok then
			return f
		end
	end
	if family == "GMR_HL2" then
		return Font.fromEnum(Enum.Font.GothamBlack)
	end
	return Font.new("rbxasset://fonts/families/Arimo.json", weight or Enum.FontWeight.Regular)
end

Derma.DEFAULT = Derma.font("GMR_Tahoma", Enum.FontWeight.Regular)
Derma.DEFAULT_BOLD = Derma.font("GMR_Tahoma", Enum.FontWeight.Bold)

function Derma.uri(png)
	return png and (Config.TextureRoot .. png) or ""
end

-- Applies a 9-slice skin rectangle to an ImageLabel/ImageButton.
function Derma.skin(img, name)
	local t = Derma.TEX[name]
	img.BackgroundTransparency = 1
	if not SKIN or not t then
		img.BackgroundTransparency = 0
		img.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
		return img
	end
	img.Image = SKIN
	img.ImageRectOffset = Vector2.new(t[1], t[2])
	img.ImageRectSize = Vector2.new(t[3], t[4])
	img.ScaleType = Enum.ScaleType.Slice
	img.SliceCenter = Rect.new(t[5], t[6], t[3] - t[7], t[4] - t[8])
	return img
end

function Derma.panel(parent, name, size, pos)
	local p = Instance.new("ImageLabel")
	p.Size = size or UDim2.fromScale(1, 1)
	p.Position = pos or UDim2.new()
	p.BorderSizePixel = 0
	Derma.skin(p, name or "Panel")
	p.Parent = parent
	return p
end

function Derma.label(parent, text, size, pos, color, textSize, bold)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size or UDim2.new(1, 0, 0, 16)
	l.Position = pos or UDim2.new()
	l.FontFace = bold and Derma.DEFAULT_BOLD or Derma.DEFAULT
	l.TextSize = textSize or 13
	l.TextColor3 = color or Derma.Colors.LabelDark
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Text = text
	l.Parent = parent
	return l
end

function Derma.icon(parent, name, pos)
	local png = UI.icons and UI.icons[name]
	local i = Instance.new("ImageLabel")
	i.BackgroundTransparency = 1
	i.Size = UDim2.fromOffset(16, 16)
	i.Position = pos or UDim2.new()
	i.Image = Derma.uri(png)
	i.Parent = parent
	return i
end

-- DButton: skin texture that swaps on hover/press
function Derma.button(parent, text, size, pos, onClick)
	local b = Instance.new("ImageButton")
	b.Size = size or UDim2.fromOffset(100, 22)
	b.Position = pos or UDim2.new()
	b.AutoButtonColor = false
	Derma.skin(b, "Button")
	local l = Derma.label(b, text, UDim2.fromScale(1, 1), nil, Derma.Colors.ButtonText, 13)
	l.TextXAlignment = Enum.TextXAlignment.Center
	b.MouseEnter:Connect(function()
		Derma.skin(b, "ButtonHover")
		l.TextColor3 = Derma.Colors.ButtonHover
	end)
	b.MouseLeave:Connect(function()
		Derma.skin(b, "Button")
		l.TextColor3 = Derma.Colors.ButtonText
	end)
	b.MouseButton1Down:Connect(function()
		Derma.skin(b, "ButtonDown")
	end)
	b.MouseButton1Up:Connect(function()
		Derma.skin(b, "ButtonHover")
	end)
	if onClick then
		b.MouseButton1Click:Connect(onClick)
	end
	b.Parent = parent
	return b, l
end

return Derma
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Client effects modelled on GMod's: propspawn shimmer, remover dissolve, physgun
-- freeze/unfreeze rings, balloon confetti, explosions, break dust, debris fade-out,
-- toolgun tracer and selection ring. Sprites are GMod's own (sprites/, effects/).
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Effects = {}

local Visuals
local EX = Assets.Index.extras or {}
local camera = workspace.CurrentCamera

local function sprite(name)
	return EX[name] and (Config.TextureRoot .. EX[name]) or ""
end
Effects.sprite = sprite

local function anchorAt(pos)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	return a
end

local function burst(parent, props, count)
	local pe = Instance.new("ParticleEmitter")
	pe.Enabled = false
	for k, v in pairs(props) do
		pe[k] = v
	end
	pe.Parent = parent
	pe:Emit(count)
	return pe
end

local function visualOf(collider, timeout)
	if not Visuals or not collider then
		return nil
	end
	local t = os.clock()
	while os.clock() - t < (timeout or 1) do
		local v = Visuals.visualFor(collider)
		if v then
			return v
		end
		task.wait(0.05)
	end
	return nil
end

local function flash(target, color, from, duration)
	local h = Instance.new("Highlight")
	h.Adornee = target
	h.FillColor = color
	h.FillTransparency = from
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = target
	TweenService:Create(h, TweenInfo.new(duration), { FillTransparency = 1 }):Play()
	Debris:AddItem(h, duration + 0.1)
end

-- Billboard sprite that grows and fades (rings, glows)
local function ring(pos, color, startSize, endSize, duration, tex)
	local a = anchorAt(pos)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(startSize, startSize)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.Parent = a
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.Image = sprite(tex or "ring")
	img.ImageColor3 = color
	img.Parent = bb
	TweenService:Create(bb, TweenInfo.new(duration), { Size = UDim2.fromScale(endSize, endSize) }):Play()
	TweenService:Create(img, TweenInfo.new(duration), { ImageTransparency = 1 }):Play()
	Debris:AddItem(a, duration + 0.1)
end
Effects.ring = ring

local handlers = {}

handlers.propspawn = function(model)
	local root = model and model.PrimaryPart
	local v = visualOf(root, 1.5)
	if v then
		flash(v, Color3.new(1, 1, 1), 0, 0.7)
	end
end

handlers.remove = function(cf, size, model)
	local root = model and model.PrimaryPart
	local v = root and Visuals and Visuals.visualFor(root)
	if v then
		flash(v, Color3.new(1, 1, 1), 0, 0.35)
	end
	local a = anchorAt(cf.Position)
	burst(a, {
		Texture = sprite("spark"),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(0.25, 0),
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(4, 10),
		SpreadAngle = Vector2.new(180, 180),
		Shape = Enum.ParticleEmitterShape.Box,
	}, math.clamp(math.floor(size.Magnitude * 6), 10, 60))
	Debris:AddItem(a, 1.5)
end

handlers.freeze = function(part)
	if not part then
		return
	end
	ring(part.Position, Color3.fromRGB(110, 200, 255), 1, math.max(4, part.Size.Magnitude * 1.4), 0.5)
	local v = Visuals and Visuals.visualFor(part)
	if v then
		flash(v, Color3.fromRGB(110, 200, 255), 0.4, 0.5)
	end
end

handlers.unfreeze = function(part)
	if not part then
		return
	end
	ring(part.Position, Color3.fromRGB(255, 200, 90), math.max(4, part.Size.Magnitude * 1.4), 1, 0.4)
end

handlers.balloonpop = function(pos, color)
	local a = anchorAt(pos)
	burst(a, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(color or Color3.new(1, 0.3, 0.3)),
		Size = NumberSequence.new(0.35),
		Lifetime = NumberRange.new(0.6, 1.4),
		Speed = NumberRange.new(6, 14),
		Acceleration = Vector3.new(0, -12, 0),
		SpreadAngle = Vector2.new(180, 180),
		RotSpeed = NumberRange.new(-200, 200),
	}, 40)
	Debris:AddItem(a, 2)
end

handlers.explosion = function(pos, radius)
	local a = anchorAt(pos)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 80)
	light.Range = radius * 2
	light.Brightness = 6
	light.Parent = a
	TweenService:Create(light, TweenInfo.new(0.6), { Brightness = 0 }):Play()
	burst(a, {
		Texture = sprite("fire"),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 160), Color3.fromRGB(255, 90, 30)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, radius * 0.25), NumberSequenceKeypoint.new(1, radius * 0.6) }),
		Transparency = NumberSequence.new(0, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(radius * 0.4, radius * 1.2),
		SpreadAngle = Vector2.new(180, 180),
		RotSpeed = NumberRange.new(-90, 90),
	}, 24)
	burst(a, {
		Texture = sprite("smoke"),
		Color = ColorSequence.new(Color3.fromRGB(60, 55, 50)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, radius * 0.3), NumberSequenceKeypoint.new(1, radius * 0.9) }),
		Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(1.5, 3),
		Speed = NumberRange.new(2, 6),
		Acceleration = Vector3.new(0, 3, 0),
		SpreadAngle = Vector2.new(180, 180),
		RotSpeed = NumberRange.new(-30, 30),
	}, 16)
	burst(a, {
		Texture = sprite("spark"),
		LightEmission = 1,
		Size = NumberSequence.new(0.3, 0),
		Lifetime = NumberRange.new(0.5, 1.2),
		Speed = NumberRange.new(20, 40),
		Acceleration = Vector3.new(0, -40, 0),
		SpreadAngle = Vector2.new(180, 180),
	}, 40)
	Debris:AddItem(a, 4)
	-- screen shake if close
	local d = (camera.CFrame.Position - pos).Magnitude
	if d < radius * 3 then
		local strength = (1 - d / (radius * 3)) * 0.6
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - t0
			if t > 0.6 then
				conn:Disconnect()
				return
			end
			local k = strength * (1 - t / 0.6)
			camera.CFrame = camera.CFrame * CFrame.Angles(math.rad((math.random() - 0.5) * 4 * k), math.rad((math.random() - 0.5) * 4 * k), 0)
		end)
	end
end

local DUST = {
	wood_box = Color3.fromRGB(150, 120, 80), plastic_box = Color3.fromRGB(120, 170, 80),
	plastic_barrel = Color3.fromRGB(80, 110, 160), metal_barrel = Color3.fromRGB(110, 100, 90),
}

handlers["break"] = function(pos, size, impact)
	local a = anchorAt(pos)
	burst(a, {
		Texture = sprite("smoke"),
		Color = ColorSequence.new(DUST[impact or ""] or Color3.fromRGB(140, 130, 120)),
		Size = NumberSequence.new(size.Magnitude * 0.3, size.Magnitude * 0.7),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(1, 4),
		SpreadAngle = Vector2.new(180, 180),
	}, 10)
	Debris:AddItem(a, 2)
end

-- Toolgun tracer + selection ring at the hit point
function Effects.tracer(from, to)
	local a0, a1 = anchorAt(from), anchorAt(to)
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 0.25
	beam.Width1 = 0.25
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Texture = sprite("tracer")
	beam.TextureMode = Enum.TextureMode.Stretch
	beam.Parent = a0
	TweenService:Create(beam, TweenInfo.new(0.15), { Width0 = 0, Width1 = 0 }):Play()
	Debris:AddItem(a0, 0.2)
	Debris:AddItem(a1, 0.2)
	ring(to, Color3.new(1, 1, 1), 0.3, 2.2, 0.35)
	burst(a1, {
		Texture = sprite("spark"),
		LightEmission = 1,
		Size = NumberSequence.new(0.15, 0),
		Lifetime = NumberRange.new(0.15, 0.35),
		Speed = NumberRange.new(4, 10),
		SpreadAngle = Vector2.new(70, 70),
	}, 8)
end

function Effects.sparks(pos)
	local a = anchorAt(pos)
	burst(a, {
		Texture = sprite("spark"),
		LightEmission = 1,
		Size = NumberSequence.new(0.12, 0),
		Lifetime = NumberRange.new(0.15, 0.4),
		Speed = NumberRange.new(5, 12),
		Acceleration = Vector3.new(0, -30, 0),
		SpreadAngle = Vector2.new(90, 90),
	}, 6)
	Debris:AddItem(a, 1)
end

-- Glow sprite (physgun muzzle / grab point)
function Effects.glow(parent, size, color)
	local bb = Instance.new("BillboardGui")
	bb.Name = "GMRGlow"
	bb.Size = UDim2.fromScale(size, size)
	bb.LightInfluence = 0
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.Image = sprite("glow")
	img.ImageColor3 = color
	img.Parent = bb
	bb.Parent = parent
	return bb
end

function Effects.start(visualsModule)
	Visuals = visualsModule
	Net.event("Effect").OnClientEvent:Connect(function(name, ...)
		local h = handlers[name]
		if h then
			task.spawn(h, ...)
		end
	end)
	-- fade gibs out before the server deletes them (GMod's "fadetime")
	RunService.Heartbeat:Connect(function()
		for _, gib in ipairs(CollectionService:GetTagged("GMRDebris")) do
			local fadeAt = gib:GetAttribute("FadeAt")
			if fadeAt then
				local k = math.clamp((os.time() - fadeAt) / 3, 0, 1)
				local v = Visuals.visualFor(gib)
				if v and k > 0 then
					for _, p in ipairs(v:GetChildren()) do
						if p:IsA("BasePart") and p.Name ~= "Origin" then
							p.LocalTransparencyModifier = k
						end
					end
				end
			end
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Garry's Mod HUD: the HL2 health panel and weapon selection (positions from
-- scripts/hudlayout.res, colours/fonts from resource/ClientScheme.res, all in 640x480
-- units scaled to the screen) and GMod's notification popups (lua/includes/modules/notification.lua).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets"))
local Textures = require(script.Parent.Textures)
local Derma = require(script.Parent.Derma)
local Sfx = require(script.Parent.Sfx)

local Hud = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local UI = Assets.Index.ui or {}

-- ClientScheme colours
local FG = Color3.fromRGB(255, 220, 0) -- FgColorHud 255 220 0 220
local FG_T = 1 - 220 / 255
local BG_T = 1 - 76 / 255 -- BgColor 0 0 0 76
local DAMAGED_FG = Color3.fromRGB(180, 0, 0)

local gui, healthBox, healthLabel, healthDigits, healthGlow, hintLabel, linkLabel
local weaponSel, notices = nil, {}
local HL2 = Derma.font("GMR_HL2")
local VERDANA_BOLD = Derma.font("GMR_Verdana", Enum.FontWeight.Bold)
local ARIAL = Font.new("rbxasset://fonts/families/Arimo.json", Enum.FontWeight.Medium)

local function s()
	return camera.ViewportSize.Y / 480
end

-- HudDefault font size by vertical resolution
local function hudDefaultSize()
	local h = camera.ViewportSize.Y
	if h < 600 then
		return 9
	elseif h < 768 then
		return 13
	elseif h < 1024 then
		return 14
	elseif h <= 1200 then
		return 20
	end
	return 24
end

local function layoutHealth()
	local k = s()
	healthBox.Position = UDim2.fromOffset(16 * k, 432 * k)
	healthBox.Size = UDim2.fromOffset(102 * k, 36 * k)
	healthBox:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, math.floor(5 * k))
	healthLabel.Position = UDim2.fromOffset(8 * k, 20 * k)
	healthLabel.Size = UDim2.fromOffset(42 * k, 12 * k)
	healthLabel.TextSize = hudDefaultSize()
	for _, d in ipairs({ healthDigits, healthGlow }) do
		d.Position = UDim2.fromOffset(50 * k, 2 * k)
		d.Size = UDim2.fromOffset(50 * k, 32 * k)
		d.TextSize = 32 * k
	end
end

function Hud.build()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	gui = Instance.new("ScreenGui")
	gui.Name = "GMRHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")

	healthBox = Instance.new("Frame")
	healthBox.Name = "HudHealth"
	healthBox.BackgroundColor3 = Color3.new(0, 0, 0)
	healthBox.BackgroundTransparency = BG_T
	healthBox.BorderSizePixel = 0
	Instance.new("UICorner").Parent = healthBox
	healthBox.Parent = gui

	healthLabel = Instance.new("TextLabel")
	healthLabel.BackgroundTransparency = 1
	healthLabel.FontFace = VERDANA_BOLD
	healthLabel.TextColor3 = FG
	healthLabel.TextTransparency = FG_T
	healthLabel.TextXAlignment = Enum.TextXAlignment.Left
	healthLabel.TextYAlignment = Enum.TextYAlignment.Top
	healthLabel.Text = "HEALTH"
	healthLabel.Parent = healthBox

	healthGlow = Instance.new("TextLabel")
	healthGlow.BackgroundTransparency = 1
	healthGlow.FontFace = HL2
	healthGlow.TextColor3 = FG
	healthGlow.TextTransparency = 0.8
	healthGlow.TextStrokeColor3 = FG
	healthGlow.TextStrokeTransparency = 0.85
	healthGlow.TextXAlignment = Enum.TextXAlignment.Left
	healthGlow.TextYAlignment = Enum.TextYAlignment.Top
	healthGlow.Parent = healthBox
	healthDigits = healthGlow:Clone()
	healthDigits.TextTransparency = FG_T
	healthDigits.TextStrokeTransparency = 1
	healthDigits.Parent = healthBox

	layoutHealth()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutHealth)

	-- crosshair
	local cross = Instance.new("ImageLabel")
	cross.Name = "Crosshair"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(32, 32)
	cross.BackgroundTransparency = 1
	cross.Parent = gui
	task.spawn(function()
		local img = Textures.crosshair()
		if img then
			Textures.setContent(cross, { "ImageContent" }, img)
		else
			cross.BackgroundTransparency = 0
			cross.BackgroundColor3 = Color3.new(1, 1, 1)
			cross.Size = UDim2.fromOffset(2, 2)
		end
	end)

	hintLabel = Instance.new("TextLabel")
	hintLabel.BackgroundTransparency = 1
	hintLabel.AnchorPoint = Vector2.new(0.5, 0)
	hintLabel.Position = UDim2.new(0.5, 0, 0.5, 30)
	hintLabel.Size = UDim2.new(1, 0, 0, 20)
	hintLabel.FontFace = ARIAL
	hintLabel.TextSize = 16
	hintLabel.TextColor3 = Color3.new(1, 1, 1)
	hintLabel.TextStrokeTransparency = 0.5
	hintLabel.Text = ""
	hintLabel.Parent = gui

	linkLabel = Instance.new("TextLabel")
	linkLabel.BackgroundTransparency = 1
	linkLabel.Position = UDim2.fromOffset(8, 6)
	linkLabel.Size = UDim2.fromOffset(500, 16)
	linkLabel.FontFace = Derma.DEFAULT
	linkLabel.TextSize = 13
	linkLabel.TextColor3 = Color3.new(1, 1, 1)
	linkLabel.TextStrokeTransparency = 0.6
	linkLabel.TextXAlignment = Enum.TextXAlignment.Left
	linkLabel.Text = ""
	linkLabel.Parent = gui

	RunService.RenderStepped:Connect(Hud.step)
	return gui
end

function Hud.setCrosshair(on)
	local c = gui and gui:FindFirstChild("Crosshair")
	if c then
		c.Visible = on
	end
end

function Hud.setVisible(on)
	if gui then
		gui.Enabled = on
	end
end

function Hud.gui()
	return gui
end

function Hud.trackHumanoid(humanoid)
	local function update()
		local hp = math.max(0, math.floor(humanoid.Health + 0.5))
		healthDigits.Text = tostring(hp)
		healthGlow.Text = tostring(hp)
		local hurt = hp < 20
		local color = hurt and DAMAGED_FG or FG
		healthDigits.TextColor3 = color
		healthGlow.TextColor3 = color
		healthLabel.TextColor3 = color
		healthBox.BackgroundColor3 = hurt and Color3.fromRGB(180, 0, 0) or Color3.new(0, 0, 0)
	end
	update()
	humanoid.HealthChanged:Connect(update)
end

-- HL2 weapon selection: small 32px boxes per slot, the active one grows to 112x80 ----------
local selShownAt = -100

function Hud.showWeaponSelection(slots, selected)
	if weaponSel then
		weaponSel:Destroy()
	end
	local k = s()
	weaponSel = Instance.new("Frame")
	weaponSel.BackgroundTransparency = 1
	weaponSel.Size = UDim2.fromScale(1, 1)
	weaponSel.Parent = gui
	local small, wide, tall, gap = 32 * k, 112 * k, 80 * k, 6 * k
	local total = 0
	for i = 1, #slots do
		total = total + (i == selected and wide or small) + (i < #slots and gap or 0)
	end
	local x = (camera.ViewportSize.X - total) / 2
	for i, name in ipairs(slots) do
		local w = i == selected and wide or small
		local h = i == selected and tall or small
		local box = Instance.new("Frame")
		box.Position = UDim2.fromOffset(x, 16 * k)
		box.Size = UDim2.fromOffset(w, h)
		box.BackgroundColor3 = Color3.new(0, 0, 0)
		box.BackgroundTransparency = i == selected and (1 - 150 / 255) or (1 - 70 / 255)
		box.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, math.floor(4 * k))
		c.Parent = box
		local num = Instance.new("TextLabel")
		num.BackgroundTransparency = 1
		num.Position = UDim2.fromOffset(4 * k, 4 * k)
		num.Size = UDim2.fromOffset(12 * k, 12 * k)
		num.FontFace = VERDANA_BOLD
		num.TextSize = math.floor(11 * k * 0.9)
		num.TextColor3 = FG
		num.TextXAlignment = Enum.TextXAlignment.Left
		num.TextYAlignment = Enum.TextYAlignment.Top
		num.Text = tostring(i)
		num.Parent = box
		if i == selected then
			local t = num:Clone()
			t.Position = UDim2.fromOffset(0, 64 * k)
			t.Size = UDim2.new(1, 0, 0, 12 * k)
			t.TextSize = math.floor(8 * k * 1.1)
			t.TextXAlignment = Enum.TextXAlignment.Center
			t.TextTransparency = FG_T
			t.Text = string.upper(name)
			t.Parent = box
		end
		box.Parent = weaponSel
		x = x + w + gap
	end
	selShownAt = os.clock()
end

-- Tool gun info in the top-left, like gmod_tool's DrawHUD (GModToolName / GModToolSubtitle)
local toolPanel
function Hud.setTool(name, desc)
	if toolPanel then
		toolPanel:Destroy()
		toolPanel = nil
	end
	if not name then
		return
	end
	local k = camera.ViewportSize.Y / 1080
	toolPanel = Instance.new("Frame")
	toolPanel.BackgroundTransparency = 1
	toolPanel.Position = UDim2.fromOffset(50 * k, 40 * k)
	toolPanel.Size = UDim2.fromOffset(900 * k, 140 * k)
	toolPanel.Parent = gui
	local function line(text, font, size, y)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromOffset(0, y)
		l.Size = UDim2.new(1, 0, 0, size)
		l.FontFace = font
		l.TextSize = size
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextStrokeTransparency = 0.6
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Text = text
		l.Parent = toolPanel
	end
	line(name, Derma.font("GMR_Roboto", Enum.FontWeight.Bold), math.floor(80 * k), 0)
	line(desc or "", Derma.font("GMR_Roboto"), math.floor(24 * k), math.floor(86 * k))
end

function Hud.setWeapon(_title, _sub)
	-- the HL2 HUD shows no ammo box for the physgun/toolgun
end

function Hud.setHint(_text)
	-- GMod shows tool hints as notifications only
end

function Hud.setLink(text)
	linkLabel.Text = text or ""
end

-- GMod notifications --------------------------------------------------------------------------
local KIND = { generic = "generic", error = "error", undo = "undo", hint = "hint", cleanup = "cleanup", link = "generic" }

function Hud.notify(text, kind, length)
	kind = KIND[kind or "generic"] or "generic"
	local scrH = camera.ViewportSize.Y
	local textH = math.max(12, math.ceil(9 * scrH / 480))
	local iconH = math.ceil(textH * 1.25)
	local textSize = TextService:GetTextSize(text, textH, Enum.Font.Arial, Vector2.new(4000, textH * 2))
	local iconGap = math.ceil(iconH * 0.1)
	local w = textSize.X + math.ceil(textH * 0.75) + iconH + iconGap * 2 + 6
	local h = math.max(textSize.Y + math.ceil(textH * 0.25), iconH + iconGap * 2) + 6

	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	panel.BackgroundTransparency = 0.4
	panel.BorderSizePixel = 0
	panel.Size = UDim2.fromOffset(w, h)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = panel
	local icon = Instance.new("ImageLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromOffset(iconH, iconH)
	icon.Position = UDim2.fromOffset(3 + iconGap, (h - iconH) / 2)
	icon.Image = Derma.uri(UI.notices and UI.notices[kind])
	icon.Parent = panel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(3 + iconH + iconGap * 2, 0)
	label.Size = UDim2.new(1, -(6 + iconH + iconGap * 2), 1, 0)
	label.FontFace = ARIAL
	label.TextSize = textH
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.25
	label.Text = text
	label.Parent = panel
	local vw = camera.ViewportSize.X
	panel.Position = UDim2.fromOffset(vw + 200, scrH)
	panel.Parent = gui
	table.insert(notices, 1, { panel = panel, start = os.clock(), length = length or 3, x = vw + 200, y = scrH, vx = 0, vy = 0 })

	if kind == "error" then
		Sfx.play("error")
	elseif kind == "undo" or kind == "cleanup" then
		Sfx.play("undo")
	else
		Sfx.play("hint")
	end
end

-- same spring motion as notification.lua's UpdateNotice
function Hud.step(dt)
	local vw, vh = camera.ViewportSize.X, camera.ViewportSize.Y
	local totalH = 0
	for i = #notices, 1, -1 do
		local n = notices[i]
		if not n.panel.Parent then
			table.remove(notices, i)
		end
	end
	for _, n in ipairs(notices) do
		local w, h = n.panel.AbsoluteSize.X, n.panel.AbsoluteSize.Y
		local idealY = vh * 0.8 - h - totalH
		local idealX = vw - w - vw * 0.015
		local timeleft = n.start - (os.clock() - n.length)
		if timeleft < 0.7 then
			idealX = idealX - vw * 0.04
		end
		if timeleft < 0.2 then
			idealX = idealX + w * 2
		end
		local spd = dt * 15
		n.y = n.y + n.vy * spd
		n.x = n.x + n.vx * spd
		n.vy = n.vy + (idealY - n.y) * spd * 1
		n.vx = n.vx + (idealX - n.x) * spd * 1
		n.vy = n.vy * (0.95 - dt * 8)
		n.vx = n.vx * (0.95 - dt * 8)
		n.panel.Position = UDim2.fromOffset(n.x, n.y)
		totalH = totalH + h
		if timeleft < -0.5 then
			n.panel:Destroy()
		end
	end
	if weaponSel and os.clock() - selShownAt > 2.5 then
		weaponSel:Destroy()
		weaponSel = nil
	end
end

return Hud
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">MainMenu</string><ProtectedString name="Source"><![CDATA[-- GMod-style main menu: background art from garrysmod/backgrounds, the GMod logo, the
-- left-hand menu (Resume / Start New Game / Find Multiplayer Game / Options / Disconnect),
-- map picker with the real map thumbnails, multiplayer (Studio Link) and options pages.
-- Toggle with F1 (Roblox reserves Escape).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Derma = require(script.Parent.Derma)
local Sfx = require(script.Parent.Sfx)

local MainMenu = {}

local player = Players.LocalPlayer
local UI = Assets.Index.ui or {}
local EX = Assets.Index.extras or {}

local gui, bg, pages, items, callbacks, settings
local selectedMap
local linkLabel
local ROBOTO_BOLD = Derma.font("GMR_Roboto", Enum.FontWeight.Bold)
local ROBOTO = Derma.font("GMR_Roboto")
local ACCENT = Color3.fromRGB(40, 150, 240)

local function uri(png)
	return png and (Config.TextureRoot .. png) or ""
end

local function text(parent, str, size, pos, font, ts, color)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos or UDim2.new()
	l.FontFace = font or ROBOTO
	l.TextSize = ts or 18
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextStrokeTransparency = 0.7
	l.Text = str
	l.Parent = parent
	return l
end

local function panel(parent, size, pos)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.fromRGB(20, 22, 26)
	f.BackgroundTransparency = 0.25
	f.BorderSizePixel = 0
	f.Size = size
	f.Position = pos
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = f
	f.Parent = parent
	return f
end

local function bigButton(parent, label, size, pos, onClick)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = ACCENT
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.FontFace = ROBOTO_BOLD
	b.TextSize = 22
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = label
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = b
	b.MouseButton1Click:Connect(function()
		Sfx.play("click")
		onClick()
	end)
	b.Parent = parent
	return b
end

local function showPage(name)
	for n, p in pairs(pages) do
		p.Visible = n == name
	end
end

-- Pages ---------------------------------------------------------------------------------------
local function buildNewGame(root)
	local page = panel(root, UDim2.new(1, -460, 1, -160), UDim2.fromOffset(420, 110))
	text(page, "Start New Game", UDim2.new(1, -40, 0, 40), UDim2.fromOffset(20, 12), ROBOTO_BOLD, 30)
	local grid = Instance.new("ScrollingFrame")
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Position = UDim2.fromOffset(20, 64)
	grid.Size = UDim2.new(1, -300, 1, -84)
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.CanvasSize = UDim2.new()
	grid.ScrollBarThickness = 6
	grid.Parent = page
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(150, 178)
	layout.CellPadding = UDim2.fromOffset(10, 10)
	layout.Parent = grid
	local tiles = {}
	local function select(name)
		selectedMap = name
		for n, t in pairs(tiles) do
			t.BackgroundColor3 = n == name and ACCENT or Color3.fromRGB(45, 48, 54)
		end
	end
	for _, name in ipairs(Assets.Index.maps or {}) do
		local tile = Instance.new("TextButton")
		tile.Text = ""
		tile.AutoButtonColor = false
		tile.BorderSizePixel = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 4)
		c.Parent = tile
		local img = Instance.new("ImageLabel")
		img.BackgroundColor3 = Color3.new(0, 0, 0)
		img.BorderSizePixel = 0
		img.Position = UDim2.fromOffset(5, 5)
		img.Size = UDim2.fromOffset(140, 140)
		img.Image = uri(UI.mapThumbs and UI.mapThumbs[name])
		img.Parent = tile
		local l = text(tile, name, UDim2.new(1, -10, 0, 24), UDim2.fromOffset(5, 148), ROBOTO, 16)
		l.TextXAlignment = Enum.TextXAlignment.Center
		tile.MouseButton1Click:Connect(function()
			Sfx.play("click")
			select(name)
		end)
		tile.MouseEnter:Connect(function()
			Sfx.play("hover")
		end)
		tile.Parent = grid
		tiles[name] = tile
	end
	select(workspace:GetAttribute("GMRMap") or Config.Map)

	local side = Instance.new("Frame")
	side.BackgroundTransparency = 1
	side.Position = UDim2.new(1, -260, 0, 64)
	side.Size = UDim2.new(0, 240, 1, -84)
	side.Parent = page
	text(side, "Single Player", UDim2.new(1, 0, 0, 24), nil, ROBOTO_BOLD, 18)
	text(side, "Other Studios join through Studio Link while this map is running.", UDim2.new(1, 0, 0, 60), UDim2.fromOffset(0, 28), ROBOTO, 15, Color3.fromRGB(200, 200, 200)).TextWrapped = true
	bigButton(side, "Start Game", UDim2.new(1, 0, 0, 52), UDim2.new(0, 0, 1, -52), function()
		if selectedMap then
			callbacks.onChangeMap(selectedMap)
			MainMenu.close()
			if callbacks.onClose then
				callbacks.onClose()
			end
		end
	end)
	return page
end

local function buildMultiplayer(root)
	local page = panel(root, UDim2.new(1, -460, 1, -160), UDim2.fromOffset(420, 110))
	text(page, "Find Multiplayer Game", UDim2.new(1, -40, 0, 40), UDim2.fromOffset(20, 12), ROBOTO_BOLD, 30)
	text(page, "Studio Link: every Roblox Studio playing this place syncs through the relay (start-relay.bat).", UDim2.new(1, -40, 0, 24), UDim2.fromOffset(20, 60), ROBOTO, 16, Color3.fromRGB(210, 210, 210))
	linkLabel = text(page, "Waiting for the server...", UDim2.new(1, -40, 0, 200), UDim2.fromOffset(20, 96), Derma.DEFAULT, 16)
	linkLabel.TextYAlignment = Enum.TextYAlignment.Top
	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(260, 40)
	box.Position = UDim2.new(0, 20, 1, -64)
	box.BackgroundColor3 = Color3.fromRGB(40, 42, 48)
	box.BorderSizePixel = 0
	box.FontFace = ROBOTO
	box.TextSize = 18
	box.TextColor3 = Color3.new(1, 1, 1)
	box.PlaceholderText = "Relay IP (" .. Config.RelayHost .. ")"
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Parent = page
	bigButton(page, "Connect", UDim2.fromOffset(160, 40), UDim2.new(0, 290, 1, -64), function()
		callbacks.onLinkHost(box.Text ~= "" and box.Text or Config.RelayHost)
	end)
	return page
end

local function buildOptions(root)
	local page = panel(root, UDim2.new(1, -460, 1, -160), UDim2.fromOffset(420, 110))
	text(page, "Options", UDim2.new(1, -40, 0, 40), UDim2.fromOffset(20, 12), ROBOTO_BOLD, 30)
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromOffset(20, 70)
	list.Size = UDim2.new(1, -40, 1, -90)
	list.Parent = page
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	local order = 0
	local function stepper(label, key, step, minV, maxV, apply)
		order = order + 1
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 36)
		row.LayoutOrder = order
		row.Parent = list
		text(row, label, UDim2.new(0.5, 0, 1, 0), nil, ROBOTO, 18)
		local value = text(row, tostring(settings[key]), UDim2.new(0, 80, 1, 0), UDim2.new(1, -180, 0, 0), ROBOTO_BOLD, 18)
		value.TextXAlignment = Enum.TextXAlignment.Center
		local function set(v)
			settings[key] = math.clamp(v, minV, maxV)
			value.Text = tostring(settings[key])
			apply(settings[key])
		end
		bigButton(row, "-", UDim2.fromOffset(44, 36), UDim2.new(1, -96, 0, 0), function()
			set(settings[key] - step)
		end)
		bigButton(row, "+", UDim2.fromOffset(44, 36), UDim2.new(1, -46, 0, 0), function()
			set(settings[key] + step)
		end)
	end
	local function toggle(label, key, apply)
		order = order + 1
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 36)
		row.LayoutOrder = order
		row.Parent = list
		text(row, label, UDim2.new(0.5, 0, 1, 0), nil, ROBOTO, 18)
		local b
		b = bigButton(row, settings[key] and "On" or "Off", UDim2.fromOffset(140, 36), UDim2.new(1, -140, 0, 0), function()
			settings[key] = not settings[key]
			b.Text = settings[key] and "On" or "Off"
			apply(settings[key])
		end)
	end
	stepper("Field of view (fov_desired)", "fov", 5, 60, 100, callbacks.onFov)
	stepper("Viewmodel FOV (viewmodel_fov)", "vmfov", 2, 40, 90, callbacks.onViewmodelFov)
	stepper("Master volume", "volume", 10, 0, 100, callbacks.onVolume)
	toggle("Third person", "thirdPerson", callbacks.onThirdPerson)
	toggle("Draw crosshair", "crosshair", callbacks.onCrosshair)
	return page
end

-- Shell -----------------------------------------------------------------------------------------
function MainMenu.build(cb, st)
	callbacks = cb
	settings = st
	gui = Instance.new("ScreenGui")
	gui.Name = "GMRMainMenu"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local modal = Instance.new("TextButton")
	modal.Modal = true
	modal.BackgroundTransparency = 1
	modal.Text = ""
	modal.Size = UDim2.fromScale(0, 0)
	modal.Parent = gui

	bg = Instance.new("ImageLabel")
	bg.BackgroundColor3 = Color3.new(0, 0, 0)
	bg.BorderSizePixel = 0
	bg.AnchorPoint = Vector2.new(0.5, 0.5)
	bg.Position = UDim2.fromScale(0.5, 0.5)
	bg.Size = UDim2.fromScale(1.05, 1.05)
	bg.ScaleType = Enum.ScaleType.Crop
	bg.Parent = gui
	local shade = Instance.new("Frame")
	shade.BackgroundColor3 = Color3.new(0, 0, 0)
	shade.BorderSizePixel = 0
	shade.Size = UDim2.fromScale(1, 1)
	shade.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.4, 0.6), NumberSequenceKeypoint.new(1, 0.95),
	})
	grad.Parent = shade

	local logo = Instance.new("ImageLabel")
	logo.BackgroundTransparency = 1
	logo.Position = UDim2.fromOffset(40, 30)
	logo.Size = UDim2.fromOffset(340, 85)
	logo.ScaleType = Enum.ScaleType.Fit
	logo.Image = uri(EX.logo)
	logo.Parent = gui
	if not EX.logo then
		text(gui, "garry's mod", UDim2.fromOffset(400, 60), UDim2.fromOffset(40, 40), ROBOTO_BOLD, 48)
	end

	local menu = Instance.new("Frame")
	menu.BackgroundTransparency = 1
	menu.Position = UDim2.fromOffset(40, 150)
	menu.Size = UDim2.fromOffset(340, 400)
	menu.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = menu

	pages = {}
	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	pages.newgame = buildNewGame(root)
	pages.multiplayer = buildMultiplayer(root)
	pages.options = buildOptions(root)
	showPage(nil)

	items = {}
	local entries = {
		{ "Resume Game", function()
			MainMenu.close()
			if callbacks.onClose then
				callbacks.onClose()
			end
		end },
		{ "Start New Game", function()
			showPage("newgame")
		end },
		{ "Find Multiplayer Game", function()
			showPage("multiplayer")
		end },
		{ "Options", function()
			showPage("options")
		end },
		{ "Disconnect", function()
			callbacks.onDisconnect()
		end },
	}
	for i, e in ipairs(entries) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.BackgroundTransparency = 1
		b.Size = UDim2.new(1, 0, 0, 40)
		b.FontFace = ROBOTO_BOLD
		b.TextSize = 26
		b.TextColor3 = Color3.new(1, 1, 1)
		b.TextStrokeTransparency = 0.6
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.Text = e[1]
		b.MouseEnter:Connect(function()
			b.TextColor3 = ACCENT
			Sfx.play("hover")
		end)
		b.MouseLeave:Connect(function()
			b.TextColor3 = Color3.new(1, 1, 1)
		end)
		b.MouseButton1Click:Connect(function()
			Sfx.play("click")
			e[2]()
		end)
		b.Parent = menu
		items[i] = b
	end

	text(gui, "Garry's Mod content from your local install  ·  F1 toggles this menu", UDim2.fromOffset(700, 20), UDim2.new(0, 40, 1, -36), ROBOTO, 15, Color3.fromRGB(200, 200, 200))
end

local bgTween
function MainMenu.open()
	local list = UI.backgrounds or {}
	if #list > 0 then
		bg.Image = uri(list[math.random(1, #list)])
	end
	bg.Size = UDim2.fromScale(1.05, 1.05)
	if bgTween then
		bgTween:Cancel()
	end
	bgTween = TweenService:Create(bg, TweenInfo.new(30, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1.15, 1.15) })
	bgTween:Play()
	showPage(nil)
	gui.Enabled = true
	Sfx.play("ui_return")
end

function MainMenu.close()
	gui.Enabled = false
end

function MainMenu.toggle()
	if gui.Enabled then
		MainMenu.close()
	else
		MainMenu.open()
	end
end

function MainMenu.isOpen()
	return gui and gui.Enabled
end

function MainMenu.setLinkInfo(str)
	if linkLabel then
		linkLabel.Text = str
	end
end

return MainMenu
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[-- Source engine movement (GMod defaults) on top of the Roblox Humanoid:
-- sv_friction 8, sv_stopspeed 100, sv_accelerate 10, sv_airaccelerate 10, air wish speed
-- capped at 30 units/s, walk 200 / run 400 / crouch x0.3, fov 75 (4:3 horizontal).
-- We compute the Source velocity ourselves and drive the Humanoid with exactly that
-- direction and speed, so its own (instant) acceleration never takes over.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Movement = {}

local U = 1 / 14 -- studs per Source unit
local FRICTION = 8
local STOP_SPEED = 100 * U
local ACCELERATE = 10
local AIR_ACCELERATE = 10
local AIR_CAP = 30 * U
local CROUCH_MULT = 0.3
local EYE_DROP = (64 - 28) * U -- standing vs ducked view height
local function verticalFov(h)
	return 2 * math.deg(math.atan(math.tan(math.rad(h / 2)) * 0.75))
end
local FOV = verticalFov(75)

function Movement.setFov(h)
	FOV = verticalFov(h)
end

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controls
local velocity = Vector3.zero
local crouchAmount = 0
local isDisabled -- function returning true while noclip etc. own the character

local function key(k)
	return UserInputService:IsKeyDown(k) and 1 or 0
end

local function accelerate(vel, wishDir, wishSpeed, accel, dt, cap)
	local addCap = cap and math.min(wishSpeed, cap) or wishSpeed
	local current = vel:Dot(wishDir)
	local add = addCap - current
	if add <= 0 then
		return vel
	end
	local accelSpeed = math.min(accel * dt * wishSpeed, add)
	return vel + wishDir * accelSpeed
end

local function step(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return
	end
	camera.FieldOfView = FOV
	if isDisabled and isDisabled() then
		velocity = Vector3.zero
		return
	end

	local typing = UserInputService:GetFocusedTextBox() ~= nil
	local forward, side = 0, 0
	if not typing then
		forward = key(Enum.KeyCode.W) - key(Enum.KeyCode.S)
		side = key(Enum.KeyCode.D) - key(Enum.KeyCode.A)
	end
	local crouching = not typing and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
	local running = not typing and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)

	local look = camera.CFrame.LookVector
	local flatF = Vector3.new(look.X, 0, look.Z)
	flatF = flatF.Magnitude > 0.001 and flatF.Unit or Vector3.zAxis
	local flatR = Vector3.new(-flatF.Z, 0, flatF.X)
	local wish = flatF * forward + flatR * side
	local maxSpeed = running and Config.RunSpeed or Config.WalkSpeed
	if crouching then
		maxSpeed = maxSpeed * CROUCH_MULT
	end
	local wishDir = wish.Magnitude > 0 and wish.Unit or Vector3.zero
	local wishSpeed = wish.Magnitude > 0 and maxSpeed or 0

	-- start from the real horizontal velocity so collisions are respected
	local actual = root.AssemblyLinearVelocity
	velocity = Vector3.new(actual.X, 0, actual.Z)
	local grounded = hum.FloorMaterial ~= Enum.Material.Air

	if grounded then
		local speed = velocity.Magnitude
		if speed > 0.01 then
			local control = math.max(speed, STOP_SPEED)
			local newSpeed = math.max(speed - control * FRICTION * dt, 0)
			velocity = velocity * (newSpeed / speed)
		end
		velocity = accelerate(velocity, wishDir, wishSpeed, ACCELERATE, dt, nil)
	else
		velocity = accelerate(velocity, wishDir, wishSpeed, AIR_ACCELERATE, dt, AIR_CAP)
	end

	local speed = velocity.Magnitude
	if speed > 0.05 then
		hum.WalkSpeed = speed
		hum:Move(velocity.Unit, false)
	else
		hum.WalkSpeed = Config.WalkSpeed
		hum:Move(Vector3.zero, false)
	end

	-- duck: lower the view like GMod's 64 -> 28 unit eye height
	crouchAmount = crouchAmount + ((crouching and 1 or 0) - crouchAmount) * math.min(1, dt * 12)
	hum.CameraOffset = Vector3.new(0, -EYE_DROP * crouchAmount, 0)
end

function Movement.start(disabledFn)
	isDisabled = disabledFn
	task.spawn(function()
		local ok, module = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
		end)
		if ok and module then
			controls = module:GetControls()
			controls:Disable()
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.Space then
			return
		end
		if isDisabled and isDisabled() then
			return
		end
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Jump = true
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return Movement
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">PaintCanvas</string><ProtectedString name="Source"><![CDATA[-- Paint tool canvases: one EditableImage per (part, face), shown through a SurfaceGui.
local Textures = require(script.Parent.Textures)

local PaintCanvas = {}

local canvases = {} -- [part] = { [face] = {image=, size=Vector2} }
local PIXELS_PER_STUD = 12
local MAX_SIDE = 512

-- Face width/height in studs, matching how SurfaceGuis lay out on each face
local function faceDims(part, face)
	local s = part.Size
	if face == Enum.NormalId.Front or face == Enum.NormalId.Back then
		return s.X, s.Y
	elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		return s.Z, s.Y
	end
	return s.X, s.Z
end

-- Converts a world hit on a part into (face, uv 0..1).
function PaintCanvas.uvFromHit(part, worldPos, worldNormal)
	local lp = part.CFrame:PointToObjectSpace(worldPos)
	local ln = part.CFrame:VectorToObjectSpace(worldNormal)
	local s = part.Size
	local ax, ay, az = math.abs(ln.X), math.abs(ln.Y), math.abs(ln.Z)
	local face, u, v
	if ax >= ay and ax >= az then
		if ln.X > 0 then
			face, u, v = Enum.NormalId.Right, 0.5 - lp.Z / s.Z, 0.5 - lp.Y / s.Y
		else
			face, u, v = Enum.NormalId.Left, 0.5 + lp.Z / s.Z, 0.5 - lp.Y / s.Y
		end
	elseif ay >= az then
		if ln.Y > 0 then
			face, u, v = Enum.NormalId.Top, 0.5 + lp.X / s.X, 0.5 + lp.Z / s.Z
		else
			face, u, v = Enum.NormalId.Bottom, 0.5 + lp.X / s.X, 0.5 - lp.Z / s.Z
		end
	else
		if ln.Z > 0 then
			face, u, v = Enum.NormalId.Back, 0.5 + lp.X / s.X, 0.5 - lp.Y / s.Y
		else
			face, u, v = Enum.NormalId.Front, 0.5 - lp.X / s.X, 0.5 - lp.Y / s.Y
		end
	end
	return face, Vector2.new(math.clamp(u, 0, 1), math.clamp(v, 0, 1))
end

local function getCanvas(part, face)
	local perPart = canvases[part]
	if not perPart then
		perPart = {}
		canvases[part] = perPart
		part.Destroying:Connect(function()
			canvases[part] = nil
		end)
	end
	local c = perPart[face]
	if c then
		return c
	end
	local w, h = faceDims(part, face)
	local px = math.clamp(math.floor(w * PIXELS_PER_STUD), 16, MAX_SIDE)
	local py = math.clamp(math.floor(h * PIXELS_PER_STUD), 16, MAX_SIDE)
	local img = Textures.newImage(px, py)
	if not img then
		return nil
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "GMRPaint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = PIXELS_PER_STUD
	gui.LightInfluence = 1
	gui.Adornee = part
	local label = Instance.new("ImageLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Parent = gui
	Textures.setContent(label, { "ImageContent" }, img)
	gui.Parent = part
	c = { image = img, size = Vector2.new(px, py) }
	perPart[face] = c
	return c
end

-- Draws a stroke from uv a to uv b (both 0..1) with a pixel radius.
function PaintCanvas.stroke(part, face, a, b, color, radius)
	if not part or not part.Parent then
		return
	end
	local c = getCanvas(part, face)
	if not c then
		return
	end
	local pa = a * c.size
	local pb = b * c.size
	local dist = (pb - pa).Magnitude
	local steps = math.max(1, math.ceil(dist / math.max(1, radius * 0.5)))
	for i = 0, steps do
		local p = pa:Lerp(pb, i / steps)
		c.image:DrawCircle(Vector2.new(math.floor(p.X), math.floor(p.Y)), radius, color, 0, Enum.ImageCombineType.BlendSourceOver)
	end
end

return PaintCanvas
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Scoreboard</string><ProtectedString name="Source"><![CDATA[-- Hold Tab: GMod's default scoreboard (hostname header, one row per player with
-- Kills / Deaths / Ping), plus players from linked Studios.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")

local Derma = require(script.Parent.Derma)

local Scoreboard = {}

local player = Players.LocalPlayer
local gui, list
local linked = {}
local ROBOTO_BOLD = Derma.font("GMR_Roboto", Enum.FontWeight.Bold)
local ROBOTO = Derma.font("GMR_Roboto")

local function label(parent, str, size, pos, font, ts, color, align)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.FontFace = font
	l.TextSize = ts
	l.TextColor3 = color or Color3.fromRGB(93, 93, 93)
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.Text = str
	l.Parent = parent
	return l
end

local function row(name, kills, deaths, ping, order, note)
	local r = Instance.new("Frame")
	r.LayoutOrder = order
	r.Size = UDim2.new(1, 0, 0, 32)
	r.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
	r.BackgroundTransparency = 0.1
	r.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = r
	label(r, name, UDim2.new(1, -260, 1, 0), UDim2.fromOffset(42, 0), ROBOTO_BOLD, 20)
	if note then
		label(r, note, UDim2.new(0, 200, 1, 0), UDim2.new(0.45, 0, 0, 0), ROBOTO, 14, Color3.fromRGB(120, 120, 120))
	end
	label(r, tostring(kills), UDim2.fromOffset(60, 32), UDim2.new(1, -200, 0, 0), ROBOTO_BOLD, 20, nil, Enum.TextXAlignment.Center)
	label(r, tostring(deaths), UDim2.fromOffset(60, 32), UDim2.new(1, -140, 0, 0), ROBOTO_BOLD, 20, nil, Enum.TextXAlignment.Center)
	label(r, tostring(ping), UDim2.fromOffset(60, 32), UDim2.new(1, -80, 0, 0), ROBOTO_BOLD, 20, nil, Enum.TextXAlignment.Center)
	r.Parent = list
end

local function refresh()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local order = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		order = order + 1
		local ping = 0
		pcall(function()
			ping = math.floor(plr:GetNetworkPing() * 1000)
		end)
		row(plr.DisplayName, plr:GetAttribute("Kills") or 0, plr:GetAttribute("Deaths") or 0, ping, order)
	end
	for _, name in ipairs(linked) do
		order = order + 1
		row(name, "-", "-", "-", order, "via Studio Link")
	end
end

function Scoreboard.build()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)
	gui = Instance.new("ScreenGui")
	gui.Name = "GMRScoreboard"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 8
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0)
	root.Position = UDim2.new(0.5, 0, 0, 100)
	root.Size = UDim2.fromOffset(700, 600)
	root.Parent = gui

	local header = Instance.new("Frame")
	header.BackgroundColor3 = Color3.new(0, 0, 0)
	header.BackgroundTransparency = 0.5
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, 52)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = header
	header.Parent = root
	local title = label(header, "Garry's Mod", UDim2.fromScale(1, 1), UDim2.new(), ROBOTO_BOLD, 32, Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
	title.TextStrokeTransparency = 0.6
	RunService.Heartbeat:Connect(function()
		if gui.Enabled then
			title.Text = "Garry's Mod  -  " .. tostring(workspace:GetAttribute("GMRMap") or "")
		end
	end)

	local cols = Instance.new("Frame")
	cols.BackgroundTransparency = 1
	cols.Position = UDim2.fromOffset(0, 56)
	cols.Size = UDim2.new(1, 0, 0, 20)
	cols.Parent = root
	for i, t in ipairs({ "Kills", "Deaths", "Ping" }) do
		local l = label(cols, t, UDim2.fromOffset(60, 20), UDim2.new(1, -260 + i * 60, 0, 0), ROBOTO, 14, Color3.new(1, 1, 1), Enum.TextXAlignment.Center)
		l.TextStrokeTransparency = 0.5
	end

	list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromOffset(0, 80)
	list.Size = UDim2.new(1, 0, 1, -80)
	list.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
end

function Scoreboard.setOpen(open)
	if open then
		refresh()
	end
	gui.Enabled = open
end

function Scoreboard.setLinked(names)
	linked = names or {}
end

return Scoreboard
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[-- Local audio: Garry's Mod / HL2 sounds converted by tools/export-gmod.js and installed in
-- Studio's content folder, so they load from disk via rbxasset://sounds/gmr/...
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Assets = require(Shared.Assets)

local Sfx = {}

local SOUNDS = Assets.Index.sounds
local VOLUMES = {
	physgun_hold = 0.4,
	thruster_loop = 0.5,
	click = 0.6,
	hint = 0.6,
}

local group = Instance.new("SoundGroup")
group.Name = "GMR"
group.Parent = SoundService

local holder = Instance.new("Folder")
holder.Name = "GMRSounds"
holder.Parent = SoundService

function Sfx.setVolume(v)
	group.Volume = v
end

function Sfx.has(name)
	return SOUNDS[name] ~= nil
end

local function make(name, parent)
	local list = SOUNDS[name]
	if not list then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = Config.SoundRoot .. list[math.random(1, #list)]
	s.Volume = VOLUMES[name] or 0.7
	s.SoundGroup = group
	s.RollOffMinDistance = 6
	s.RollOffMaxDistance = 180
	s.Parent = parent
	return s
end

-- 2D sound (UI, your own gun)
function Sfx.play(name, pitch)
	local s = make(name, holder)
	if s then
		s.PlaybackSpeed = pitch or 1
		s:Play()
		Debris:AddItem(s, 8)
	end
	return s
end

-- 3D sound at a world position or on a part
function Sfx.playAt(name, where, pitch)
	if typeof(where) == "Instance" then
		local s = make(name, where)
		if s then
			s.PlaybackSpeed = pitch or 1
			s:Play()
			Debris:AddItem(s, 8)
		end
		return s
	end
	if typeof(where) ~= "Vector3" then
		return Sfx.play(name, pitch)
	end
	local att = Instance.new("Attachment")
	att.WorldPosition = where
	att.Parent = workspace.Terrain
	local s = make(name, att)
	if s then
		s.PlaybackSpeed = pitch or 1
		s:Play()
	end
	Debris:AddItem(att, 8)
	return s
end

-- Looping sound the caller stops/destroys
function Sfx.loop(name, parent)
	local s = make(name, parent or holder)
	if s then
		s.Looped = true
		s:Play()
	end
	return s
end

return Sfx
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">SpawnMenu</string><ProtectedString name="Source"><![CDATA[-- Hold-Q spawn menu laid out like Garry's Mod's: the creation menu (Spawnlists, Weapons, ...)
-- on the left and the tool menu (Tools / Options / Utilities) on the right, drawn with
-- GMod's Derma skin, silkicons and real spawn icons.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.PropCatalog)
local Config = require(Shared.Config)
local Assets = require(Shared.Assets)
local Derma = require(script.Parent.Derma)
local Sfx = require(script.Parent.Sfx)

local SpawnMenu = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local gui, root, linkInfo, cpanel, toolLines, tip
local callbacks, state

local COL = Derma.Colors

-- GMod's tool categories
local TOOL_CATEGORIES = {
	{ "Constraints", { "weld", "nocollide", "rope" } },
	{ "Construction", { "balloon", "remover", "thruster" } },
	{ "Render", { "color", "material", "paint" } },
}

local function modeById(id)
	for _, m in ipairs(Config.ToolModes) do
		if m.id == id then
			return m
		end
	end
	return nil
end

-- DPropertySheet: tabs on top, Tab_Control body ---------------------------------------------
local function propertySheet(parent, tabs)
	local sheet = Instance.new("Frame")
	sheet.BackgroundTransparency = 1
	sheet.Size = UDim2.fromScale(1, 1)
	sheet.Parent = parent
	local body = Derma.panel(sheet, "TabControl", UDim2.new(1, 0, 1, -20), UDim2.fromOffset(0, 20))
	body.ZIndex = 1
	local strip = Instance.new("Frame")
	strip.BackgroundTransparency = 1
	strip.Size = UDim2.new(1, 0, 0, 28)
	strip.ZIndex = 2
	strip.Parent = sheet
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip
	local pages, buttons = {}, {}
	local function select(name)
		for n, pg in pairs(pages) do
			local active = n == name
			pg.Visible = active
			local b = buttons[n]
			Derma.skin(b.tab, active and "TabActive" or "TabInactive")
			b.tab.Size = UDim2.fromOffset(b.width, active and 28 or 20)
			b.label.TextColor3 = active and COL.TabActive or COL.TabInactive
		end
	end
	for i, t in ipairs(tabs) do
		local name, icon = t[1], t[2]
		local width = 16 + 4 + #name * 6 + 18
		local tab = Instance.new("ImageButton")
		tab.AutoButtonColor = false
		tab.LayoutOrder = i
		tab.ZIndex = 2
		tab.Parent = strip
		Derma.icon(tab, icon, UDim2.fromOffset(8, 3)).ZIndex = 3
		local label = Derma.label(tab, name, UDim2.new(1, -28, 0, 20), UDim2.fromOffset(26, 1), COL.TabInactive, 13)
		label.ZIndex = 3
		label.TextWrapped = false
		buttons[name] = { tab = tab, label = label, width = width }
		tab.MouseButton1Click:Connect(function()
			Sfx.play("click")
			select(name)
		end)
		local page = Instance.new("Frame")
		page.BackgroundTransparency = 1
		page.Position = UDim2.fromOffset(8, 8)
		page.Size = UDim2.new(1, -16, 1, -16)
		page.Visible = false
		page.ZIndex = 2
		page.Parent = body
		pages[name] = page
	end
	return pages, select
end

local function scroller(parent)
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = UDim2.fromScale(1, 1)
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = Color3.fromRGB(150, 150, 150)
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.CanvasSize = UDim2.new()
	s.Parent = parent
	return s
end

function SpawnMenu.tooltip(text)
	if not tip then
		return
	end
	tip.Visible = text ~= nil
	if text then
		tip:FindFirstChildOfClass("TextLabel").Text = text
		local m = UserInputService:GetMouseLocation()
		tip.Position = UDim2.fromOffset(m.X + 12, m.Y - 20)
	end
end

-- Spawnlists: DTree on the left, spawn icons on the right -----------------------------------
local function buildSpawnlists(page)
	local tree = Derma.panel(page, "Tree", UDim2.new(0, 200, 1, 0))
	local treeList = scroller(tree)
	treeList.Position = UDim2.fromOffset(2, 2)
	treeList.Size = UDim2.new(1, -4, 1, -4)
	local tl = Instance.new("UIListLayout")
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Parent = treeList

	local content = Derma.panel(page, "Panel", UDim2.new(1, -206, 1, 0), UDim2.fromOffset(206, 0))
	local iconArea = scroller(content)
	iconArea.Position = UDim2.fromOffset(6, 6)
	iconArea.Size = UDim2.new(1, -12, 1, -12)
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(64, 64)
	grid.CellPadding = UDim2.fromOffset(2, 2)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = iconArea

	local nodes = {}
	local function showCategory(cat)
		for _, c in ipairs(iconArea:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		for n, node in pairs(nodes) do
			node.TextColor3 = n == (cat or "*") and COL.TreeSelected or COL.TreeNormal
		end
		local i = 0
		for _, entry in ipairs(Catalog.List) do
			if cat == nil or entry.category == cat then
				i = i + 1
				local icon = Instance.new("ImageButton")
				icon.LayoutOrder = i
				icon.BackgroundTransparency = 1
				icon.AutoButtonColor = false
				icon.Image = entry.icon and Derma.uri(entry.icon) or ""
				if not entry.icon then
					local l = Derma.label(icon, entry.name, UDim2.fromScale(1, 1), nil, COL.LabelDark, 11)
					l.TextXAlignment = Enum.TextXAlignment.Center
				end
				local hover = Derma.panel(icon, "Selection", UDim2.fromScale(1, 1))
				hover.Visible = false
				icon.MouseEnter:Connect(function()
					hover.Visible = true
					SpawnMenu.tooltip(entry.model)
				end)
				icon.MouseLeave:Connect(function()
					hover.Visible = false
					SpawnMenu.tooltip(nil)
				end)
				icon.MouseButton1Click:Connect(function()
					Sfx.play("click")
					callbacks.onSpawn(entry.name)
				end)
				icon.Parent = iconArea
			end
		end
	end

	local order = 0
	local function node(text, icon, indent, key)
		order = order + 1
		local row = Instance.new("TextButton")
		row.Text = ""
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 18)
		row.LayoutOrder = order
		Derma.icon(row, icon, UDim2.fromOffset(4 + indent * 16, 1))
		local label = Derma.label(row, text, UDim2.new(1, -(24 + indent * 16), 1, 0), UDim2.fromOffset(24 + indent * 16, 0), COL.TreeNormal, 13)
		label.TextWrapped = false
		row.Parent = treeList
		if key then
			nodes[key] = label
			row.MouseButton1Click:Connect(function()
				Sfx.play("click")
				showCategory(key ~= "*" and key or nil)
			end)
		end
	end
	node("Your Spawnlists", "folder", 0, nil)
	local seen = {}
	for _, entry in ipairs(Catalog.List) do
		if not seen[entry.category] then
			seen[entry.category] = true
			node(entry.category, "page", 1, entry.category)
		end
	end
	node("Browse", "folder_database", 0, nil)
	node("All Props", "world", 1, "*")
	showCategory(Catalog.List[1] and Catalog.List[1].category)
end

local function buildWeapons(page)
	local content = Derma.panel(page, "Panel")
	local area = scroller(content)
	area.Position = UDim2.fromOffset(6, 6)
	area.Size = UDim2.new(1, -12, 1, -12)
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(128, 128)
	grid.CellPadding = UDim2.fromOffset(4, 4)
	grid.Parent = area
	for _, w in ipairs({ { "Physics Gun", "Physgun" }, { "Tool Gun", "Toolgun" } }) do
		Derma.button(area, w[1], UDim2.fromOffset(128, 128), nil, function()
			Sfx.play("click")
			callbacks.onWeapon(w[2])
		end)
	end
end

local function emptyPage(page, text)
	local p = Derma.panel(page, "Panel")
	Derma.label(p, text, UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 10), COL.LabelDark, 13)
end

-- Tool menu: DCategoryList of tools on the left, control panel on the right ------------------
local function rebuildControlPanel()
	for _, c in ipairs(cpanel:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local mode = modeById(state.mode)
	if not mode then
		return
	end
	local order = 0
	local function add(inst)
		order = order + 1
		inst.LayoutOrder = order
		inst.Parent = cpanel
		return inst
	end
	local header = Derma.panel(nil, "CategoryHeader", UDim2.new(1, -10, 0, 20))
	Derma.label(header, mode.name, UDim2.new(1, -10, 1, 0), UDim2.fromOffset(6, 0), COL.CategoryHeader, 13, true)
	add(header)
	local desc = Derma.label(nil, mode.desc, UDim2.new(1, -10, 0, 30), nil, COL.LabelDark, 13)
	desc.TextYAlignment = Enum.TextYAlignment.Top
	add(desc)

	local function numSlider(label, key, step, minV, maxV)
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, -10, 0, 22)
		Derma.label(row, label, UDim2.new(0.5, 0, 1, 0), nil, COL.LabelDark, 13)
		local value = Derma.label(row, tostring(state[key]), UDim2.new(0, 60, 1, 0), UDim2.new(1, -112, 0, 0), COL.LabelDark, 13)
		value.TextXAlignment = Enum.TextXAlignment.Right
		Derma.button(row, "-", UDim2.fromOffset(22, 20), UDim2.new(1, -46, 0, 1), function()
			state[key] = math.clamp(state[key] - step, minV, maxV)
			value.Text = tostring(state[key])
		end)
		Derma.button(row, "+", UDim2.fromOffset(22, 20), UDim2.new(1, -22, 0, 1), function()
			state[key] = math.clamp(state[key] + step, minV, maxV)
			value.Text = tostring(state[key])
		end)
		add(row)
	end

	local id = mode.id
	if id == "color" or id == "rope" or id == "balloon" or id == "paint" then
		add(Derma.label(nil, "Colour", UDim2.new(1, -10, 0, 16), nil, COL.LabelDark, 13))
		local mixer = Instance.new("Frame")
		mixer.BackgroundTransparency = 1
		mixer.Size = UDim2.new(1, -10, 0, 52)
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.fromOffset(24, 24)
		g.CellPadding = UDim2.fromOffset(2, 2)
		g.Parent = mixer
		for _, c in ipairs(Config.Palette) do
			local sw = Instance.new("TextButton")
			sw.Text = ""
			sw.AutoButtonColor = false
			sw.BackgroundColor3 = c
			sw.BorderSizePixel = c == state.color and 2 or 0
			sw.BorderColor3 = COL.LineButtonSelected
			sw.Parent = mixer
			sw.MouseButton1Click:Connect(function()
				Sfx.play("click")
				state.color = c
				rebuildControlPanel()
			end)
		end
		add(mixer)
	end
	if id == "rope" then
		numSlider("Length addition", "slack", 1, 0, 50)
	elseif id == "balloon" then
		numSlider("Force", "balloonForce", 100, 0, 3000)
		numSlider("Rope length", "ropeLength", 1, 1, 40)
	elseif id == "thruster" then
		numSlider("Force", "thrusterForce", 250, 250, 20000)
	elseif id == "paint" then
		numSlider("Brush size", "brush", 1, 1, 32)
	elseif id == "material" then
		local list = Instance.new("Frame")
		list.BackgroundTransparency = 1
		list.Size = UDim2.new(1, -10, 0, 0)
		list.AutomaticSize = Enum.AutomaticSize.Y
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.fromOffset(64, 64)
		g.CellPadding = UDim2.fromOffset(2, 2)
		g.Parent = list
		for _, m in ipairs(Assets.Index.toolMaterials) do
			local b = Instance.new("ImageButton")
			b.BackgroundTransparency = 1
			b.Image = Derma.uri(m.png)
			b.Parent = list
			if m.name == state.material then
				Derma.panel(b, "Selection")
			end
			b.MouseEnter:Connect(function()
				SpawnMenu.tooltip(m.name)
			end)
			b.MouseLeave:Connect(function()
				SpawnMenu.tooltip(nil)
			end)
			b.MouseButton1Click:Connect(function()
				Sfx.play("click")
				state.material = m.name
				rebuildControlPanel()
			end)
		end
		add(list)
	end
end

local function refreshToolLines()
	for id, line in pairs(toolLines) do
		local sel = id == state.mode
		line.frame.BackgroundColor3 = sel and COL.LineButtonSelected or (line.alt and COL.LineAltButton or COL.LineButton)
		line.label.TextColor3 = sel and COL.LineTextSelected or COL.LineText
	end
end

local function buildTools(page)
	local outer = Derma.panel(page, "CategoryOuter", UDim2.new(0, 130, 1, 0))
	local list = scroller(outer)
	list.Position = UDim2.fromOffset(2, 2)
	list.Size = UDim2.new(1, -4, 1, -4)
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = list
	toolLines = {}
	local order = 0
	for _, cat in ipairs(TOOL_CATEGORIES) do
		order = order + 1
		local header = Derma.panel(list, "CategoryHeader", UDim2.new(1, 0, 0, 20))
		header.LayoutOrder = order
		Derma.label(header, cat[1], UDim2.new(1, -10, 1, 0), UDim2.fromOffset(6, 0), COL.CategoryHeader, 13, true)
		for i, id in ipairs(cat[2]) do
			local mode = modeById(id)
			if mode then
				order = order + 1
				local line = Instance.new("TextButton")
				line.Text = ""
				line.AutoButtonColor = false
				line.BorderSizePixel = 0
				line.Size = UDim2.new(1, 0, 0, 17)
				line.LayoutOrder = order
				local label = Derma.label(line, mode.name, UDim2.new(1, -10, 1, 0), UDim2.fromOffset(8, 0), COL.LineText, 13)
				line.Parent = list
				toolLines[id] = { frame = line, label = label, alt = i % 2 == 0 }
				line.MouseButton1Click:Connect(function()
					Sfx.play("click")
					state.mode = id
					refreshToolLines()
					rebuildControlPanel()
					callbacks.onTool(id)
				end)
			end
		end
	end
	local cp = Derma.panel(page, "Panel", UDim2.new(1, -136, 1, 0), UDim2.fromOffset(136, 0))
	cpanel = scroller(cp)
	cpanel.Position = UDim2.fromOffset(5, 5)
	cpanel.Size = UDim2.new(1, -10, 1, -10)
	local cl = Instance.new("UIListLayout")
	cl.Padding = UDim.new(0, 5)
	cl.SortOrder = Enum.SortOrder.LayoutOrder
	cl.Parent = cpanel
	refreshToolLines()
	rebuildControlPanel()
end

local function listPanel(page)
	local p = Derma.panel(page, "Panel")
	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromOffset(8, 8)
	list.Size = UDim2.new(1, -16, 1, -16)
	list.Parent = p
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = list
	return list
end

local function header(list, text, order)
	local h = Derma.panel(list, "CategoryHeader", UDim2.new(1, 0, 0, 20))
	h.LayoutOrder = order
	Derma.label(h, text, UDim2.new(1, -10, 1, 0), UDim2.fromOffset(6, 0), COL.CategoryHeader, 13, true)
end

local function buildUtilities(page)
	local list = listPanel(page)
	header(list, "Cleanup", 1)
	Derma.button(list, "Undo", UDim2.new(1, 0, 0, 22), nil, callbacks.onUndo).LayoutOrder = 2
	Derma.button(list, "Cleanup Everything", UDim2.new(1, 0, 0, 22), nil, callbacks.onCleanup).LayoutOrder = 3
	header(list, "Studio Link", 4)
	local help = Derma.label(list, "Every Studio playing this place syncs through the relay (start-relay.bat). For another PC, type the relay PC's IP.", UDim2.new(1, 0, 0, 30), nil, COL.LabelDark, 13)
	help.LayoutOrder = 5
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 22)
	row.LayoutOrder = 6
	row.Parent = list
	local boxBg = Derma.panel(row, "TextBox", UDim2.new(1, -90, 1, 0))
	local box = Instance.new("TextBox")
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -8, 1, 0)
	box.Position = UDim2.fromOffset(4, 0)
	box.FontFace = Derma.DEFAULT
	box.TextSize = 13
	box.TextColor3 = COL.LabelDark
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.PlaceholderText = Config.RelayHost
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Parent = boxBg
	Derma.button(row, "Connect", UDim2.fromOffset(84, 22), UDim2.new(1, -84, 0, 0), function()
		callbacks.onLinkHost(box.Text ~= "" and box.Text or Config.RelayHost)
	end)
	linkInfo = Derma.label(list, "Link: waiting for server...", UDim2.new(1, 0, 0, 100), nil, COL.LabelDark, 13)
	linkInfo.TextYAlignment = Enum.TextYAlignment.Top
	linkInfo.LayoutOrder = 7
end

local function buildOptions(page)
	local list = listPanel(page)
	header(list, "Camera", 1)
	Derma.button(list, "Toggle Third Person", UDim2.new(1, 0, 0, 22), nil, callbacks.onToggleView).LayoutOrder = 2
end

local function layout()
	local vw, vh = camera.ViewportSize.X, camera.ViewportSize.Y
	local mx = math.clamp((vw - 1024) * 0.1, 25, 256)
	local my = math.clamp((vh - 768) * 0.1, 25, 256)
	root.Position = UDim2.fromOffset(mx, my)
	root.Size = UDim2.fromOffset(vw - mx * 2, vh - my * 2)
end

function SpawnMenu.build(cb, st)
	callbacks = cb
	state = st

	gui = Instance.new("ScreenGui")
	gui.Name = "GMRSpawnMenu"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.DisplayOrder = 5
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")

	-- frees the mouse while in first person
	local modal = Instance.new("TextButton")
	modal.Modal = true
	modal.BackgroundTransparency = 1
	modal.Text = ""
	modal.Size = UDim2.fromScale(0, 0)
	modal.Parent = gui

	root = Instance.new("Frame")
	root.BackgroundTransparency = 1
	root.Parent = gui
	layout()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)

	local TOOL_W = 460
	local left = Instance.new("Frame")
	left.BackgroundTransparency = 1
	left.Size = UDim2.new(1, -(TOOL_W + 8), 1, 0)
	left.Parent = root
	local right = Instance.new("Frame")
	right.BackgroundTransparency = 1
	right.Size = UDim2.new(0, TOOL_W, 1, 0)
	right.Position = UDim2.new(1, -TOOL_W, 0, 0)
	right.Parent = root

	local creation, selectCreation = propertySheet(left, {
		{ "Spawnlists", "application_view_tile" }, { "Weapons", "gun" }, { "Entities", "bricks" },
		{ "NPCs", "monkey" }, { "Vehicles", "car" }, { "Post Process", "picture" }, { "Dupes", "brick_link" }, { "Saves", "disk" },
	})
	buildSpawnlists(creation["Spawnlists"])
	buildWeapons(creation["Weapons"])
	for _, n in ipairs({ "Entities", "NPCs", "Vehicles", "Post Process", "Dupes", "Saves" }) do
		emptyPage(creation[n], "Nothing here yet.")
	end
	selectCreation("Spawnlists")

	local tools, selectTools = propertySheet(right, { { "Tools", "wrench" }, { "Options", "cog" }, { "Utilities", "page_white_wrench" } })
	buildTools(tools["Tools"])
	buildOptions(tools["Options"])
	buildUtilities(tools["Utilities"])
	selectTools("Tools")

	tip = Derma.panel(gui, "Tooltip", UDim2.fromOffset(360, 20))
	tip.ZIndex = 10
	local tl = Derma.label(tip, "", UDim2.new(1, -10, 1, 0), UDim2.fromOffset(5, 0), COL.LabelDark, 13)
	tl.ZIndex = 11
	tl.TextWrapped = false
	tip.Visible = false
end

function SpawnMenu.setOpen(open)
	gui.Enabled = open
	if not open then
		SpawnMenu.tooltip(nil)
	end
end

function SpawnMenu.isOpen()
	return gui and gui.Enabled
end

function SpawnMenu.setLinkInfo(str)
	if linkInfo then
		linkInfo.Text = str
	end
end

function SpawnMenu.syncTool()
	if toolLines then
		refreshToolLines()
		rebuildControlPanel()
	end
end

return SpawnMenu
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Textures</string><ProtectedString name="Source"><![CDATA[-- Texture handling for the converted GMod content.
-- Prop/weapon textures are loaded from Studio's local content folder into EditableImages
-- (so the Colour tool can tint them and the Paint tool can draw); huge map textures use
-- the rbxasset:// path directly to stay inside the EditableImage memory budget.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Textures = {}

local images = {} -- png -> EditableImage | false
local tinted = {} -- png|hex -> EditableImage
local editableOk = true
local warned = false

local function warnOnce(msg)
	if not warned then
		warned = true
		warn("[GMR] " .. msg .. " Enable Game Settings > Security > 'Allow Mesh / Image APIs'. Falling back to plain rbxasset textures.")
	end
end

function Textures.uri(png)
	return Config.TextureRoot .. png
end

-- Content properties were renamed over time, so try each candidate.
local function setContent(inst, props, image)
	local content = Content.fromObject(image)
	for _, prop in ipairs(props) do
		local ok = pcall(function()
			inst[prop] = content
		end)
		if ok then
			return true
		end
	end
	return false
end
Textures.setContent = setContent

function Textures.newImage(w, h)
	if not editableOk then
		return nil
	end
	local ok, img = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if not ok or not img then
		editableOk = false
		warnOnce("EditableImage unavailable (" .. tostring(img) .. ").")
		return nil
	end
	return img
end

-- Loads a local GMod texture into an EditableImage (cached).
function Textures.image(png)
	if images[png] ~= nil then
		return images[png] or nil
	end
	if not editableOk then
		return nil
	end
	local ok, img = pcall(function()
		return AssetService:CreateEditableImageAsync(Content.fromUri(Textures.uri(png)))
	end)
	if not ok or not img then
		images[png] = false
		warnOnce("Couldn't load " .. png .. " into an EditableImage (" .. tostring(img) .. ").")
		return nil
	end
	images[png] = img
	return img
end

-- Multiplies a texture by a colour, like GMod's render colour.
local function tintedImage(png, color)
	local key = png .. "|" .. color:ToHex()
	if tinted[key] then
		return tinted[key]
	end
	local src = Textures.image(png)
	if not src then
		return nil
	end
	local size = src.Size
	local img = Textures.newImage(size.X, size.Y)
	if not img then
		return nil
	end
	local buf = src:ReadPixelsBuffer(Vector2.zero, size)
	local r, g, b = color.R, color.G, color.B
	for i = 0, size.X * size.Y - 1 do
		local o = i * 4
		buffer.writeu8(buf, o, math.floor(buffer.readu8(buf, o) * r))
		buffer.writeu8(buf, o + 1, math.floor(buffer.readu8(buf, o + 1) * g))
		buffer.writeu8(buf, o + 2, math.floor(buffer.readu8(buf, o + 2) * b))
	end
	img:WritePixelsBuffer(Vector2.zero, size, buf)
	tinted[key] = img
	return img
end

-- Applies a texture to a MeshPart. useEditable=false skips EditableImage (maps).
function Textures.applyMesh(meshPart, png, tint, useEditable)
	if not png then
		meshPart.Color = tint or Color3.new(1, 1, 1)
		return
	end
	if useEditable ~= false then
		local img
		if tint and tint ~= Color3.new(1, 1, 1) then
			img = tintedImage(png, tint)
		else
			img = Textures.image(png)
		end
		if img and setContent(meshPart, { "TextureContent" }, img) then
			return
		end
	end
	pcall(function()
		meshPart.TextureContent = Content.fromUri(Textures.uri(png))
	end)
	pcall(function()
		meshPart.TextureID = Textures.uri(png)
	end)
end

-- GMod-style crosshair, drawn into an EditableImage
function Textures.crosshair()
	local img = Textures.newImage(32, 32)
	if not img then
		return nil
	end
	local white = Color3.new(1, 1, 1)
	img:DrawRectangle(Vector2.new(15, 15), Vector2.new(2, 2), white, 0, Enum.ImageCombineType.Overwrite)
	img:DrawRectangle(Vector2.new(15, 6), Vector2.new(2, 5), white, 0.2, Enum.ImageCombineType.Overwrite)
	img:DrawRectangle(Vector2.new(15, 21), Vector2.new(2, 5), white, 0.2, Enum.ImageCombineType.Overwrite)
	img:DrawRectangle(Vector2.new(6, 15), Vector2.new(5, 2), white, 0.2, Enum.ImageCombineType.Overwrite)
	img:DrawRectangle(Vector2.new(21, 15), Vector2.new(5, 2), white, 0.2, Enum.ImageCombineType.Overwrite)
	return img
end

function Textures.isSupported()
	return editableOk
end

return Textures
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Viewmodel</string><ProtectedString name="Source"><![CDATA[-- First-person viewmodels: GMod's c_ weapon models + c_arms hands, animated with the real
-- Source sequences. The EditableMesh gets the model's bones (bind pose) so Roblox skins it
-- on the GPU; each frame we only set ~80 Bone.Transforms, interpolated between frames.
-- If the engine doesn't hand back Bone instances, vertices are skinned on the CPU instead.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Textures = require(script.Parent.Textures)

local Viewmodel = {}
Viewmodel.__index = Viewmodel

-- GMod draws viewmodels with viewmodel_fov 54 (4:3 horizontal) while the world uses fov 75,
-- i.e. the viewmodel is magnified by k = tan(world/2)/tan(vm/2). Projection only depends on
-- x/z, so sliding the (rigid, bone-animated) model toward the eye by depth*(1/k - 1)
-- magnifies it by ~k around its typical depth without deforming it.
local function vFov(h)
	return 2 * math.atan(math.tan(math.rad(h / 2)) * 0.75)
end
local worldFov, vmFov = 75, 54
local VM_SCALE = math.tan(vFov(worldFov) / 2) / math.tan(vFov(vmFov) / 2)

function Viewmodel.setFov(world, viewmodel)
	worldFov = world or worldFov
	vmFov = viewmodel or vmFov
	VM_SCALE = math.tan(vFov(worldFov) / 2) / math.tan(vFov(vmFov) / 2)
end

-- Muzzle positions in viewmodel space (studs, before FOV scaling)
local MUZZLE = {
	Physgun = Vector3.new(0.75, -0.7, -3.4),
	Toolgun = Vector3.new(0.5, -0.45, -1.6),
}

local function readCFrame(buf, base)
	local f = function(k)
		return buffer.readf32(buf, base + k * 4)
	end
	return CFrame.new(f(3), f(7), f(11), f(0), f(1), f(2), f(4), f(5), f(6), f(8), f(9), f(10))
end

local seqCache = {}
local function sequenceBuffer(blob)
	if not seqCache[blob] then
		seqCache[blob] = Assets.blobBuffer(blob)
	end
	return seqCache[blob]
end

local function decodeSkinned(blob)
	local buf = Assets.blobBuffer(blob)
	local nv = buffer.readu32(buf, 0)
	local nt = buffer.readu32(buf, 4)
	local m = {
		nv = nv, nt = nt, buf = buf, pos = table.create(nv), bones = table.create(nv), weights = table.create(nv),
		nrmAt = 8 + nv * 12, uvAt = 8 + nv * 15, idxAt = 8 + nv * 29, wide = nv > 65535,
	}
	local boneAt, weightAt = 8 + nv * 23, 8 + nv * 26
	for i = 0, nv - 1 do
		local p = 8 + i * 12
		m.pos[i + 1] = Vector3.new(buffer.readf32(buf, p), buffer.readf32(buf, p + 4), buffer.readf32(buf, p + 8))
		local b, w = {}, {}
		for k = 0, 2 do
			local wt = buffer.readu8(buf, weightAt + i * 3 + k) / 255
			if wt > 0 then
				table.insert(b, buffer.readu8(buf, boneAt + i * 3 + k))
				table.insert(w, wt)
			end
		end
		m.bones[i + 1], m.weights[i + 1] = b, w
	end
	return m
end

function Viewmodel.new(weapon)
	local def = Assets.Index.viewmodels and Assets.Index.viewmodels[weapon]
	if not def or not def.bind then
		return nil
	end
	local self = setmetatable({}, Viewmodel)
	self.weapon = weapon
	self.def = def
	self.model = Instance.new("Model")
	self.model.Name = "Viewmodel_" .. weapon
	self.meshes = {}
	self.seq = "idle"
	self.time = 0
	self.muzzleOffset = MUZZLE[weapon] or Vector3.new(0.5, -0.5, -2)

	local bindBuf = Assets.blobBuffer(def.bind)
	self.bind, self.bindInv = {}, {}
	for i = 0, def.bones - 1 do
		local cf = readCFrame(bindBuf, i * 48)
		self.bind[i] = cf
		self.bindInv[i] = cf:Inverse()
	end
	local pose = self:pose("idle", 0)

	for _, part in ipairs(def.parts) do
		local ok, err = pcall(function()
			self:buildPart(part, pose)
		end)
		if not ok then
			warn("[GMR] viewmodel mesh failed: " .. tostring(err))
		end
	end
	if #self.meshes == 0 then
		self.model:Destroy()
		return nil
	end
	self:play("draw")
	return self
end

function Viewmodel:buildPart(part, pose)
	local m = decodeSkinned(part.blob)
	-- centre on the idle pose so the MeshPart's bounds sit around what is actually drawn
	local minV, maxV = Vector3.one * math.huge, -Vector3.one * math.huge
	for i = 1, m.nv do
		local p = self:skinVertex(m, i, pose)
		minV, maxV = minV:Min(p), maxV:Max(p)
	end
	local center = (minV + maxV) / 2
	local shift = CFrame.new(-center)

	local em = AssetService:CreateEditableMesh()
	local boneIds = {}
	local okBones = pcall(function()
		for i = 0, self.def.bones - 1 do
			boneIds[i] = em:AddBone({ Name = "b" .. i, CFrame = shift * self.bind[i] })
		end
	end)
	local vids, nids, uids = table.create(m.nv), table.create(m.nv), table.create(m.nv)
	for i = 1, m.nv do
		-- GPU path keeps bind-pose vertices; CPU path starts in the idle pose
		local p = okBones and m.pos[i] or self:skinVertex(m, i, pose)
		vids[i] = em:AddVertex(p - center)
		if okBones and #m.bones[i] > 0 then
			local ids = {}
			for k, b in ipairs(m.bones[i]) do
				ids[k] = boneIds[b]
			end
			em:SetVertexBones(vids[i], ids)
			em:SetVertexBoneWeights(vids[i], m.weights[i])
		end
		local q = m.nrmAt + (i - 1) * 3
		nids[i] = em:AddNormal(Vector3.new(buffer.readi8(m.buf, q) / 127, buffer.readi8(m.buf, q + 1) / 127, buffer.readi8(m.buf, q + 2) / 127))
		local u = m.uvAt + (i - 1) * 8
		local v = buffer.readf32(m.buf, u + 4)
		if Config.FlipV then
			v = 1 - v
		end
		uids[i] = em:AddUV(Vector2.new(buffer.readf32(m.buf, u), v))
	end
	for t = 0, m.nt - 1 do
		local a, b, c
		if m.wide then
			local p = m.idxAt + t * 12
			a, b, c = buffer.readu32(m.buf, p), buffer.readu32(m.buf, p + 4), buffer.readu32(m.buf, p + 8)
		else
			local p = m.idxAt + t * 6
			a, b, c = buffer.readu16(m.buf, p), buffer.readu16(m.buf, p + 2), buffer.readu16(m.buf, p + 4)
		end
		if Config.FlipWinding then
			b, c = c, b
		end
		local f = em:AddTriangle(vids[a + 1], vids[b + 1], vids[c + 1])
		em:SetFaceNormals(f, { nids[a + 1], nids[b + 1], nids[c + 1] })
		em:SetFaceUVs(f, { uids[a + 1], uids[b + 1], uids[c + 1] })
	end
	local mp = AssetService:CreateMeshPartAsync(Content.fromObject(em), { CollisionFidelity = Enum.CollisionFidelity.Box })
	mp.Anchored = true
	mp.CanCollide = false
	mp.CanQuery = false
	mp.CanTouch = false
	mp.CastShadow = false
	Textures.applyMesh(mp, part.tex, nil, false)
	mp.Parent = self.model

	local bones = {}
	for _, d in ipairs(mp:GetDescendants()) do
		if d:IsA("Bone") then
			local idx = tonumber(string.sub(d.Name, 2))
			if idx then
				bones[idx] = d
			end
		end
	end
	local gpu = okBones and next(bones) ~= nil
	table.insert(self.meshes, {
		em = em, m = m, part = mp, center = center, baseSize = mp.Size, vids = vids, bones = bones, gpu = gpu,
	})
end

-- Bone poses for a (fractional) frame, interpolated
function Viewmodel:pose(seqName, frameF)
	local seq = self.def.seqs[seqName]
	if not seq then
		return nil
	end
	local buf = sequenceBuffer(seq.blob)
	local n = self.def.bones
	local f0 = math.floor(frameF)
	local f1 = math.min(f0 + 1, seq.frames - 1)
	if seq.loop and f0 + 1 >= seq.frames then
		f1 = 0
	end
	local a = frameF - f0
	local out = table.create(n)
	for i = 0, n - 1 do
		local c0 = readCFrame(buf, ((f0 * n) + i) * 48)
		if a > 0.001 and f1 ~= f0 then
			c0 = c0:Lerp(readCFrame(buf, ((f1 * n) + i) * 48), a)
		end
		out[i] = c0
	end
	return out
end

function Viewmodel:skinVertex(m, i, pose)
	local v = m.pos[i]
	local bones, weights = m.bones[i], m.weights[i]
	if #bones == 0 then
		return v
	end
	local acc = Vector3.zero
	for k, b in ipairs(bones) do
		acc = acc + (pose[b] * self.bindInv[b] * v) * weights[k]
	end
	return acc
end

function Viewmodel:play(seqName)
	if not self.def.seqs[seqName] then
		seqName = "idle"
	end
	self.seq = seqName
	self.time = 0
end

function Viewmodel:has(seqName)
	return self.def.seqs[seqName] ~= nil
end

function Viewmodel:update(dt, cameraCFrame)
	self.time = self.time + dt
	local seq = self.def.seqs[self.seq]
	if not seq then
		return
	end
	local frameF = self.time * seq.fps
	if frameF >= seq.frames - 1 then
		if seq.loop then
			frameF = frameF % math.max(1, seq.frames)
		else
			self:play(self.seq == "hold" and "hold" or "idle")
			frameF = 0
			seq = self.def.seqs[self.seq]
		end
	end
	local pose = self:pose(self.seq, frameF)
	local origin = cameraCFrame * CFrame.new(0, 0, self:depthShift())
	for _, mesh in ipairs(self.meshes) do
		local c = mesh.center
		mesh.part.CFrame = origin * CFrame.new(c)
		if mesh.gpu then
			for i, bone in pairs(mesh.bones) do
				bone.Transform = self.bindInv[i] * pose[i]
			end
		else
			local m, em, vids = mesh.m, mesh.em, mesh.vids
			for i = 1, m.nv do
				em:SetPosition(vids[i], self:skinVertex(m, i, pose) - c)
			end
		end
	end
end

function Viewmodel:setVisible(visible)
	for _, mesh in ipairs(self.meshes) do
		mesh.part.LocalTransparencyModifier = visible and 0 or 1
	end
end

function Viewmodel:depthShift()
	local z, n = 0, 0
	for _, mesh in ipairs(self.meshes) do
		z, n = z + mesh.center.Z, n + 1
	end
	local depth = n > 0 and z / n or -2
	return -depth * (1 - 1 / VM_SCALE)
end

function Viewmodel:muzzle(cameraCFrame)
	return cameraCFrame * CFrame.new(0, 0, self:depthShift()) * self.muzzleOffset
end

function Viewmodel:destroy()
	self.model:Destroy()
	for _, mesh in ipairs(self.meshes) do
		pcall(function()
			mesh.em:Destroy()
		end)
	end
end

return Viewmodel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Visuals</string><ProtectedString name="Source"><![CDATA[-- Props, gibs, static props and world weapons now carry their real GMod meshes from the
-- server (SpecialMesh + rbxasset:// .mesh files, see PropCatalog.dress), so clients don't
-- build anything here. This module just answers "what should effects highlight/fade".
local Visuals = {}

-- The visible thing for a collider: its prop/weapon model if it has one, else the collider
-- itself (its SpecialMesh children are the visible meshes).
function Visuals.visualFor(collider)
	if not collider or not collider.Parent then
		return nil
	end
	local parent = collider.Parent
	if parent:IsA("Model") and parent.PrimaryPart == collider then
		return parent
	end
	return collider
end

function Visuals.start() end

return Visuals
]]></ProtectedString></Properties></Item></Item>
<Item class="LocalScript" referent="RBX0000002B"><Properties><string name="Name">SandboxClient</string><ProtectedString name="Source"><![CDATA[-- Sandbox client: input, weapons (physgun / toolgun / hands), viewmodel, effects, noclip.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local TextChatService = game:GetService("TextChatService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Assets = require(Shared.Assets)

local Modules = script.Parent:WaitForChild("Modules")
local Textures = require(Modules.Textures)
local Visuals = require(Modules.Visuals)
local Viewmodel = require(Modules.Viewmodel)
local Movement = require(Modules.Movement)
local Effects = require(Modules.Effects)
local MainMenu = require(Modules.MainMenu)
local Scoreboard = require(Modules.Scoreboard)
local Sfx = require(Modules.Sfx)
local Hud = require(Modules.Hud)
local SpawnMenu = require(Modules.SpawnMenu)
local PaintCanvas = require(Modules.PaintCanvas)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local R = {
	Notify = Net.event("Notify"),
	Sfx = Net.event("Sfx"),
	SpawnProp = Net.event("SpawnProp"),
	Undo = Net.event("Undo"),
	Cleanup = Net.event("Cleanup"),
	PhysGrab = Net.func("PhysGrab"),
	PhysRelease = Net.event("PhysRelease"),
	PhysUnfreeze = Net.event("PhysUnfreeze"),
	PhysUnfreezeAll = Net.event("PhysUnfreezeAll"),
	ToolFire = Net.event("ToolFire"),
	ToolReset = Net.event("ToolReset"),
	ToolTracer = Net.event("ToolTracer"),
	ThrusterToggle = Net.event("ThrusterToggle"),
	Equip = Net.event("Equip"),
	Flashlight = Net.event("Flashlight"),
	Paint = Net.event("Paint"),
	PaintHistory = Net.func("PaintHistory"),
	RemoteChat = Net.event("RemoteChat"),
	LinkStatus = Net.event("LinkStatus"),
	LinkSetHost = Net.event("LinkSetHost"),
	ChangeMap = Net.event("ChangeMap"),
	Disconnect = Net.event("Disconnect"),
}

local state = {
	weapon = "Physgun",
	mode = "remover",
	color = Config.Palette[3],
	material = "models/debug/debugwhite",
	slack = 2,
	balloonForce = 400,
	ropeLength = 8,
	thrusterForce = 1500,
	brush = 4,
	firstPerson = true,
}

local function modeInfo(id)
	for _, m in ipairs(Config.ToolModes) do
		if m.id == id then
			return m
		end
	end
	return Config.ToolModes[1]
end

-- Aiming --------------------------------------------------------------------------------
local viewmodel

local function aimRay()
	local vp = camera.ViewportSize
	return camera:ViewportPointToRay(vp.X / 2, vp.Y / 2)
end

local function aim()
	local ray = aimRay()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local ghosts = workspace:FindFirstChild("RemotePlayers")
	if ghosts then
		table.insert(ignore, ghosts)
	end
	params.FilterDescendantsInstances = ignore
	return workspace:Raycast(ray.Origin, ray.Direction * Config.ReachDistance, params), ray
end

local function propOf(inst)
	while inst and inst ~= workspace do
		if inst:IsA("Model") and CollectionService:HasTag(inst, "GMRProp") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

local function isFirstPerson()
	return (camera.Focus.Position - camera.CFrame.Position).Magnitude < 1.5
end

-- invisible attachment that follows the viewmodel's muzzle (beam/tracer start point)
local vmMuzzle = Instance.new("Attachment")
vmMuzzle.Name = "GMRViewmodelMuzzle"
vmMuzzle.Parent = workspace.Terrain

local function muzzleAttachment()
	if viewmodel and isFirstPerson() then
		return vmMuzzle
	end
	local char = player.Character
	local gun = char and char:FindFirstChild("GMRWeapon")
	return gun and gun.PrimaryPart and gun.PrimaryPart:FindFirstChild("Muzzle")
end

local function muzzlePosition()
	local m = muzzleAttachment()
	if m then
		return m.WorldPosition
	end
	return camera.CFrame.Position + camera.CFrame.LookVector * 2
end

-- Weapons / viewmodel --------------------------------------------------------------------
local function rebuildViewmodel()
	if viewmodel then
		viewmodel:destroy()
		viewmodel = nil
	end
	local vm = Viewmodel.new(state.weapon)
	if vm then
		vm.model.Parent = camera
		viewmodel = vm
	end
end

local function playViewmodel(seq)
	if viewmodel then
		viewmodel:play(seq)
	end
end

local SLOT_NAMES = { "Physics Gun", "Tool Gun", "Hands" }

local function equip(weapon)
	state.weapon = weapon
	R.Equip:FireServer(weapon, modeInfo(state.mode).name)
	rebuildViewmodel()
	for i, w in ipairs(Config.Weapons) do
		if w == weapon then
			Hud.showWeaponSelection(SLOT_NAMES, i)
		end
	end
	if weapon == "Toolgun" then
		local m = modeInfo(state.mode)
		Hud.setTool(m.name, m.desc)
	else
		Hud.setTool(nil)
	end
	Sfx.play("click")
end

-- HL2 viewmodel bob while walking (no trailing lag, so aiming stays crisp)
local bobTime = 0
RunService.RenderStepped:Connect(function(dt)
	local fp = isFirstPerson()
	if viewmodel then
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
		bobTime = bobTime + dt * math.min(speed, 30) * 0.45
		local amount = math.min(speed / 15, 1)
		local camCF = camera.CFrame * CFrame.new(math.sin(bobTime) * 0.03 * amount, -math.abs(math.cos(bobTime)) * 0.04 * amount, 0)
		viewmodel:setVisible(fp)
		viewmodel:update(dt, camCF)
		vmMuzzle.WorldPosition = viewmodel:muzzle(camCF)
	end
	-- hide our own third-person gun while in first person
	local char = player.Character
	local worldGun = char and char:FindFirstChild("GMRWeapon")
	local gunVisual = worldGun and worldGun.PrimaryPart and Visuals.visualFor(worldGun.PrimaryPart)
	if gunVisual then
		for _, p in ipairs(gunVisual:GetDescendants()) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = fp and 1 or 0
			end
		end
	end
end)

-- Physgun --------------------------------------------------------------------------------
local grab
local mouseDown = false
local rotating = false
local lastReload
local rotDelta = Vector2.zero
local ContextActionService = game:GetService("ContextActionService")

-- E + mouse: rotate the held prop. Mouse movement is sunk so the camera stays still
-- (the camera module reads it through ContextActionService at a lower priority).
local function startRotate()
	if rotating then
		return
	end
	rotating = true
	rotDelta = Vector2.zero
	ContextActionService:BindActionAtPriority("GMRPhysRotate", function(_, _, input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			rotDelta = rotDelta + Vector2.new(input.Delta.X, input.Delta.Y)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 100, Enum.UserInputType.MouseMovement)
end

local function stopRotate()
	if not rotating then
		return
	end
	rotating = false
	ContextActionService:UnbindAction("GMRPhysRotate")
end

local function endGrab(freeze)
	if not grab then
		return
	end
	local g = grab
	grab = nil
	g.att:Destroy()
	for _, gl in ipairs(g.glows or {}) do
		gl:Destroy()
	end
	if g.loop then
		g.loop:Destroy()
	end
	stopRotate()
	R.PhysRelease:FireServer(freeze)
	Sfx.play(freeze and "physgun_freeze" or "physgun_off")
end

local function beginGrab()
	local hit, ray = aim()
	if not hit then
		return
	end
	local part = hit.Instance
	local model = propOf(part)
	if not model or model:GetAttribute("Remote") then
		return
	end
	local offset = part.CFrame:PointToObjectSpace(hit.Position)
	local ok = R.PhysGrab:InvokeServer(part, offset)
	if not ok then
		Sfx.play("error")
		return
	end
	if not mouseDown or state.weapon ~= "Physgun" then
		R.PhysRelease:FireServer(false)
		return
	end
	local att = Instance.new("Attachment")
	att.Name = "GMRPhysgun"
	att.Position = offset
	att.Parent = part
	local glowEnd = Effects.glow(att, 1.6, Color3.fromRGB(90, 220, 255))
	local glowMuzzle = Effects.glow(muzzleAttachment() or vmMuzzle, 1.2, Color3.fromRGB(90, 220, 255))
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = math.huge
	ap.MaxVelocity = math.huge
	ap.Responsiveness = Config.PhysgunResponsiveness
	ap.Position = hit.Position
	ap.Parent = att
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = math.huge
	ao.MaxAngularVelocity = math.huge
	ao.Responsiveness = Config.PhysgunResponsiveness
	ao.CFrame = part.CFrame.Rotation
	ao.Parent = att
	grab = {
		part = part,
		att = att,
		ap = ap,
		ao = ao,
		dist = (hit.Position - ray.Origin).Magnitude,
		rel = camera.CFrame.Rotation:Inverse() * part.CFrame.Rotation,
		loop = Sfx.loop("physgun_hold"),
		glows = { glowEnd, glowMuzzle },
	}
	Sfx.play("physgun_on")
	playViewmodel("fire")
end

RunService.RenderStepped:Connect(function()
	if not grab then
		return
	end
	if not grab.part.Parent then
		endGrab(false)
		return
	end
	if rotating then
		local d = rotDelta
		rotDelta = Vector2.zero
		local k = 0.006
		grab.rel = CFrame.Angles(d.Y * k, d.X * k, 0) * grab.rel
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			-- Shift snaps to 45 degree steps like GMod
			local world = camera.CFrame.Rotation * grab.rel
			local x, y, z = world:ToEulerAnglesXYZ()
			local step = math.rad(45)
			local snapped = CFrame.Angles(math.floor(x / step + 0.5) * step, math.floor(y / step + 0.5) * step, math.floor(z / step + 0.5) * step)
			grab.rel = camera.CFrame.Rotation:Inverse() * snapped
		end
	end
	local ray = aimRay()
	grab.ap.Position = ray.Origin + ray.Direction.Unit * grab.dist
	grab.ao.CFrame = camera.CFrame.Rotation * grab.rel
end)

-- Toolgun ----------------------------------------------------------------------------------
local function tracer(from, to)
	Effects.tracer(from, to)
end

local function toolOpts()
	local force = state.mode == "thruster" and state.thrusterForce or state.balloonForce
	return {
		color = state.color,
		material = state.material,
		slack = state.slack,
		force = force,
		ropeLength = state.ropeLength,
	}
end

local function fireTool()
	local hit = aim()
	local from = muzzlePosition()
	Sfx.play("toolgun_shot")
	playViewmodel("fire")
	if not hit then
		return
	end
	tracer(from, hit.Position)
	R.ToolFire:FireServer(state.mode, hit.Instance, hit.Position, hit.Normal, toolOpts(), from)
end

-- Paint (EditableImage) --------------------------------------------------------------------
local lastPaint
local paintAccum = 0

RunService.Heartbeat:Connect(function(dt)
	if not (mouseDown and state.weapon == "Toolgun" and state.mode == "paint" and not SpawnMenu.isOpen()) then
		lastPaint = nil
		return
	end
	paintAccum = paintAccum + dt
	if paintAccum < 1 / 30 then
		return
	end
	paintAccum = 0
	local hit = aim()
	if not hit or not hit.Instance:IsA("BasePart") or hit.Instance == workspace.Terrain then
		lastPaint = nil
		return
	end
	local face, uv = PaintCanvas.uvFromHit(hit.Instance, hit.Position, hit.Normal)
	local from = uv
	if lastPaint and lastPaint.part == hit.Instance and lastPaint.face == face then
		from = lastPaint.uv
	end
	PaintCanvas.stroke(hit.Instance, face, from, uv, state.color, state.brush)
	R.Paint:FireServer(hit.Instance, face, from, uv, state.color, state.brush)
	lastPaint = { part = hit.Instance, face = face, uv = uv }
end)

R.Paint.OnClientEvent:Connect(function(part, face, a, b, color, radius)
	PaintCanvas.stroke(part, face, a, b, color, radius)
end)

-- Held-prop beams for everyone -----------------------------------------------------------
local beams = {} -- [model] = {beam=, att=}

local function muzzleFor(userId)
	if userId == player.UserId then
		return muzzleAttachment()
	end
	local p = Players:GetPlayerByUserId(userId)
	local gun = p and p.Character and p.Character:FindFirstChild("GMRWeapon")
	return gun and gun.PrimaryPart and gun.PrimaryPart:FindFirstChild("Muzzle")
end

RunService.RenderStepped:Connect(function()
	for _, model in ipairs(CollectionService:GetTagged("GMRHeld")) do
		local info = beams[model]
		local part = model:FindFirstChild(model:GetAttribute("HeldPart") or "", true)
		if part and not info then
			local att = Instance.new("Attachment")
			att.Position = model:GetAttribute("HeldOffset") or Vector3.zero
			att.Parent = part
			local beam = Instance.new("Beam")
			beam.Attachment1 = att
			beam.Width0 = 0.25
			beam.Width1 = 0.12
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.LightInfluence = 0
			beam.Segments = 20
			beam.CurveSize0 = 4
			beam.Color = ColorSequence.new(Color3.fromRGB(80, 230, 255))
			beam.Transparency = NumberSequence.new(0)
			if Assets.Index.extras.physbeam then
				beam.Texture = Config.TextureRoot .. Assets.Index.extras.physbeam
				beam.TextureMode = Enum.TextureMode.Wrap
				beam.TextureLength = 4
				beam.TextureSpeed = 2
			end
			beam.Parent = att
			info = { beam = beam, att = att }
			beams[model] = info
		end
		if info then
			local m = muzzleFor(model:GetAttribute("HeldBy") or 0)
			if info.beam.Attachment0 ~= m then
				info.beam.Attachment0 = m
			end
		end
	end
	for model, info in pairs(beams) do
		if not model.Parent or not CollectionService:HasTag(model, "GMRHeld") then
			info.att:Destroy()
			beams[model] = nil
		end
	end
end)

-- Thruster flames + hum ---------------------------------------------------------------------
local function watchThruster(model)
	local function update()
		local body = model.PrimaryPart
		local nozzle = body and body:FindFirstChild("ThrustAttachment")
		if not nozzle then
			return
		end
		local fx = nozzle:FindFirstChild("GMRFlame")
		local hum = nozzle:FindFirstChild("thruster_loop")
		if model:GetAttribute("On") then
			if not fx then
				fx = Instance.new("ParticleEmitter")
				fx.Name = "GMRFlame"
				fx.EmissionDirection = Enum.NormalId.Top
				fx.Rate = 80
				fx.Lifetime = NumberRange.new(0.15, 0.3)
				fx.Speed = NumberRange.new(14, 18)
				fx.SpreadAngle = Vector2.new(8, 8)
				fx.LightEmission = 1
				fx.Size = NumberSequence.new(0.6, 0)
				fx.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 80, 20))
				fx.Parent = nozzle
			end
			if not hum then
				Sfx.loop("thruster_loop", nozzle)
			end
		else
			if fx then
				fx:Destroy()
			end
			if hum then
				hum:Destroy()
			end
		end
	end
	model:GetAttributeChangedSignal("On"):Connect(update)
	update()
end
CollectionService:GetInstanceAddedSignal("GMRThruster"):Connect(watchThruster)
for _, m in ipairs(CollectionService:GetTagged("GMRThruster")) do
	watchThruster(m)
end

-- Impact sounds -------------------------------------------------------------------------------
local lastImpact = setmetatable({}, { __mode = "k" })

local function watchImpacts(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Touched:Connect(function(other)
				if other:IsDescendantOf(model) then
					return
				end
				local speed = (p.AssemblyLinearVelocity - other.AssemblyLinearVelocity).Magnitude
				if speed < 18 then
					return
				end
				local now = os.clock()
				if lastImpact[p] and now - lastImpact[p] < 0.2 then
					return
				end
				lastImpact[p] = now
				local family = p:GetAttribute("Impact") or "plastic_box"
				Sfx.playAt("impact_" .. family .. (speed > 40 and "_hard" or "_soft"), p.Position)
				if speed > 40 and string.find(family, "metal") then
					Effects.sparks(p.Position)
				end
			end)
		end
	end
end
CollectionService:GetInstanceAddedSignal("GMRProp"):Connect(function(m)
	task.defer(watchImpacts, m)
end)
for _, m in ipairs(CollectionService:GetTagged("GMRProp")) do
	watchImpacts(m)
end

-- Noclip ----------------------------------------------------------------------------------------
local noclip = false
local savedCollide = {}

local function setNoclip(on)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	noclip = on
	hum.PlatformStand = on
	if on then
		savedCollide = {}
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				savedCollide[p] = p.CanCollide
			end
		end
	else
		for p, v in pairs(savedCollide) do
			if p.Parent then
				p.CanCollide = v
			end
		end
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

RunService.Stepped:Connect(function()
	if not noclip or not player.Character then
		return
	end
	for _, p in ipairs(player.Character:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not noclip then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or UserInputService:GetFocusedTextBox() then
		return
	end
	local function key(k)
		return UserInputService:IsKeyDown(k) and 1 or 0
	end
	local cf = camera.CFrame
	local dir = cf.LookVector * (key(Enum.KeyCode.W) - key(Enum.KeyCode.S))
		+ cf.RightVector * (key(Enum.KeyCode.D) - key(Enum.KeyCode.A))
		+ Vector3.yAxis * (key(Enum.KeyCode.Space) - key(Enum.KeyCode.LeftControl))
	local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and Config.NoclipFastSpeed or Config.NoclipSpeed
	local pos = root.Position
	if dir.Magnitude > 0.01 then
		pos = pos + dir.Unit * speed * dt
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = root.CFrame.LookVector
	end
	root.CFrame = CFrame.lookAt(pos, pos + look.Unit)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end)

-- Source movement (accel/friction/air strafe/crouch) --------------------------------------------
Movement.start(function()
	return noclip or MainMenu.isOpen()
end)

-- Camera mode ------------------------------------------------------------------------------------
local function applyView()
	if state.firstPerson then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 40
	end
end

-- Spawn menu ---------------------------------------------------------------------------------------
local function spawnProp(name)
	local hit, ray = aim()
	local pos = hit and hit.Position or (ray.Origin + ray.Direction.Unit * 20)
	local normal = hit and hit.Normal or Vector3.yAxis
	R.SpawnProp:FireServer(name, pos, normal)
end

SpawnMenu.build({
	onSpawn = spawnProp,
	onTool = function(id)
		state.mode = id
		R.ToolReset:FireServer()
		equip("Toolgun")
	end,
	onWeapon = function(w)
		equip(w)
	end,
	onUndo = function()
		R.Undo:FireServer()
	end,
	onCleanup = function()
		R.Cleanup:FireServer()
	end,
	onToggleView = function()
		state.firstPerson = not state.firstPerson
		applyView()
	end,
	onLinkHost = function(host)
		R.LinkSetHost:FireServer(host)
	end,
}, state)

-- Input --------------------------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input, processed)
	if UserInputService:GetFocusedTextBox() then
		return
	end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.F1 then
		MainMenu.toggle()
		Hud.setVisible(not MainMenu.isOpen())
		return
	end
	if MainMenu.isOpen() then
		return
	end
	if kc == Enum.KeyCode.Tab then
		Scoreboard.setOpen(true)
		return
	end
	if kc == Enum.KeyCode.Q then
		SpawnMenu.setOpen(true)
		if grab then
			endGrab(false)
		end
		return
	end
	if SpawnMenu.isOpen() then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if processed then
			return
		end
		mouseDown = true
		if state.weapon == "Physgun" then
			task.spawn(beginGrab)
		elseif state.weapon == "Toolgun" then
			if state.mode == "paint" then
				Sfx.play("toolgun_shot", 1.4)
			else
				fireTool()
			end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		if grab then
			endGrab(true)
		end
	elseif processed then
		return
	elseif kc == Enum.KeyCode.One then
		equip("Physgun")
	elseif kc == Enum.KeyCode.Two then
		equip("Toolgun")
	elseif kc == Enum.KeyCode.Three then
		equip("Hands")
	elseif kc == Enum.KeyCode.Z then
		R.Undo:FireServer()
	elseif kc == Enum.KeyCode.V then
		setNoclip(not noclip)
	elseif kc == Enum.KeyCode.F then
		R.Flashlight:FireServer()
	elseif kc == Enum.KeyCode.G then
		R.ThrusterToggle:FireServer()
	elseif kc == Enum.KeyCode.E then
		if grab then
			startRotate()
		end
	elseif kc == Enum.KeyCode.R then
		if state.weapon == "Physgun" then
			-- R unfreezes what you aim at; double-tap R unfreezes all your frozen props
			local now = os.clock()
			if lastReload and now - lastReload < 0.4 then
				R.PhysUnfreezeAll:FireServer()
				lastReload = nil
			else
				lastReload = now
				local hit = aim()
				if hit then
					R.PhysUnfreeze:FireServer(hit.Instance)
				end
			end
		elseif state.weapon == "Toolgun" then
			R.ToolReset:FireServer()
			Hud.notify("Tool selection cleared", "generic")
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Tab then
		Scoreboard.setOpen(false)
	elseif input.KeyCode == Enum.KeyCode.Q then
		SpawnMenu.setOpen(false)
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		mouseDown = false
		if grab then
			endGrab(false)
		end
	elseif input.KeyCode == Enum.KeyCode.E then
		stopRotate()
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel and grab then
		grab.dist = math.max(Config.PhysgunMinDistance, grab.dist + input.Position.Z * Config.PhysgunScrollStep)
	end
end)

-- Server messages -------------------------------------------------------------------------------------
R.Notify.OnClientEvent:Connect(function(text, kind)
	Hud.notify(text, kind)
	if kind == "hint" then
		Hud.setHint(text)
	else
		Hud.setHint("")
	end
end)

R.Sfx.OnClientEvent:Connect(function(name, pos)
	Sfx.playAt(name, pos)
end)

R.ToolTracer.OnClientEvent:Connect(function(userId, from, to)
	if userId ~= player.UserId then
		tracer(from, to)
		Sfx.playAt("toolgun_shot", from)
	end
end)

R.RemoteChat.OnClientEvent:Connect(function(from, text)
	local line = string.format("[%s] %s", tostring(from), tostring(text))
	local ok = pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		general:DisplaySystemMessage(line)
	end)
	if not ok then
		pcall(function()
			StarterGui:SetCore("ChatMakeSystemMessage", { Text = line, Color = Color3.fromRGB(190, 150, 255) })
		end)
	end
end)

R.LinkStatus.OnClientEvent:Connect(function(status)
	if typeof(status) ~= "table" then
		return
	end
	if status.event then
		Hud.notify(status.event, "link")
	end
	local short
	if status.connected then
		short = string.format("● Studio Link: %s · %d other Studio(s)", status.name or "?", #(status.peers or {}))
	elseif status.enabled then
		short = "○ Studio Link: no relay at " .. tostring(status.host)
	else
		short = ""
	end
	Hud.setLink(short)
	local lines = {
		"This Studio: " .. tostring(status.name),
		"Relay: " .. tostring(status.host) .. "  via " .. tostring(status.transport or "none"),
		"State: " .. (status.connected and "connected" or ("offline " .. tostring(status.err or ""))),
	}
	for _, peer in ipairs(status.peers or {}) do
		table.insert(lines, "  ↔ " .. tostring(peer))
	end
	SpawnMenu.setLinkInfo(table.concat(lines, "\n"))
	MainMenu.setLinkInfo(table.concat(lines, "\n"))
	Scoreboard.setLinked(status.peers)
end)

-- Startup -------------------------------------------------------------------------------------------------
Visuals.start()
Effects.start(Visuals)
Hud.build()
Scoreboard.build()

local settings = { fov = 75, vmfov = 54, volume = 100, thirdPerson = false, crosshair = true }
MainMenu.build({
	onChangeMap = function(name)
		R.ChangeMap:FireServer(name)
		Hud.setVisible(true)
	end,
	onDisconnect = function()
		R.Disconnect:FireServer()
	end,
	onLinkHost = function(host)
		R.LinkSetHost:FireServer(host)
	end,
	onFov = function(v)
		Movement.setFov(v)
		Viewmodel.setFov(v, nil)
	end,
	onViewmodelFov = function(v)
		Viewmodel.setFov(nil, v)
	end,
	onVolume = function(v)
		Sfx.setVolume(v / 100)
	end,
	onThirdPerson = function(on)
		state.firstPerson = not on
		applyView()
	end,
	onCrosshair = function(on)
		Hud.setCrosshair(on)
	end,
	onClose = function()
		Hud.setVisible(true)
	end,
}, settings)

local function onCharacter(char)
	noclip = false
	grab = nil
	stopRotate()
	local hum = char:WaitForChild("Humanoid")
	Hud.trackHumanoid(hum)
	char:WaitForChild("HumanoidRootPart")
	task.wait(0.2)
	equip(state.weapon)
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end
applyView()
MainMenu.open()
Hud.setVisible(false)

task.spawn(function()
	local ok, history = pcall(function()
		return R.PaintHistory:InvokeServer()
	end)
	if ok and typeof(history) == "table" then
		for _, s in ipairs(history) do
			PaintCanvas.stroke(s[1], s[2], s[3], s[4], s[5], s[6])
		end
	end
end)

task.delay(3, function()
	if not Textures.isSupported() then
		Hud.notify("EditableImage disabled: see Output for how to enable it", "error")
	end
end)
